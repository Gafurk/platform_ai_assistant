2026-05-13T21:03:21.513Z {"session_id":"41f2eab1-8bcc-4841-8211-32ca523860b0","transcript_path":"C:\\Users\\yasmi\\.claude\\projects\\e--workstuff-platform-ai-assistant\\41f2eab1-8bcc-4841-8211-32ca523860b0.jsonl","cwd":"e:\\workstuff\\platform_ai_assistant","permission_mode":"acceptEdits","effort":{"level":"medium"},"hook_event_name":"PostToolUse","tool_name":"Edit","tool_input":{"file_path":"e:\\workstuff\\platform_ai_assistant\\app\\services\\llm_service.py","old_string":"    if intent or entity or page:\n        intent_label = _INTENT_LABELS.get(intent or \"\", \"не определён\")\n        dynamic_parts.append(\n            f\"<intent_context>\\n\"\n            f\"Интент: {intent_label}\\n\"\n            f\"Тип пользователя: {entity or 'не определено'}\\n\"\n            f\"Страница: {page or 'не указана'}\\n\"\n            f\"</intent_context>\"\n        )","new_string":"    if intent or entity or page or situation:\n        intent_label = _INTENT_LABELS.get(intent or \"\", \"не определён\")\n        ctx_lines = [\n            f\"Интент: {intent_label}\",\n            f\"Тип пользователя: {entity or 'не определено'}\",\n            f\"Страница: {page or 'не указана'}\",\n        ]\n        if situation:\n            ctx_lines.append(f\"Выбранная ситуация: {situation}\")\n        dynamic_parts.append(\n            \"<intent_context>\\n\" + \"\\n\".join(ctx_lines) + \"\\n</intent_context>\"\n        )","replace_all":false},"tool_response":{"filePath":"e:\\workstuff\\platform_ai_assistant\\app\\services\\llm_service.py","oldString":"    if intent or entity or page:\n        intent_label = _INTENT_LABELS.get(intent or \"\", \"не определён\")\n        dynamic_parts.append(\n            f\"<intent_context>\\n\"\n            f\"Интент: {intent_label}\\n\"\n            f\"Тип пользователя: {entity or 'не определено'}\\n\"\n            f\"Страница: {page or 'не указана'}\\n\"\n            f\"</intent_context>\"\n        )","newString":"    if intent or entity or page or situation:\n        intent_label = _INTENT_LABELS.get(intent or \"\", \"не определён\")\n        ctx_lines = [\n            f\"Интент: {intent_label}\",\n            f\"Тип пользователя: {entity or 'не определено'}\",\n            f\"Страница: {page or 'не указана'}\",\n        ]\n        if situation:\n            ctx_lines.append(f\"Выбранная ситуация: {situation}\")\n        dynamic_parts.append(\n            \"<intent_context>\\n\" + \"\\n\".join(ctx_lines) + \"\\n</intent_context>\"\n        )","originalFile":"from __future__ import annotations\n\nimport httpx\nimport os\nfrom typing import Optional\nfrom dotenv import load_dotenv\n\nload_dotenv()\n\nLLM_PROVIDER = os.getenv(\"LLM_PROVIDER\", \"openai\")\nOLLAMA_BASE_URL = os.getenv(\"OLLAMA_BASE_URL\", \"http://localhost:11434\")\nOLLAMA_MODEL = os.getenv(\"OLLAMA_MODEL\", \"llama3.2\")\nOPENAI_API_KEY = os.getenv(\"OPENAI_API_KEY\", \"\")\nOPENAI_MODEL = os.getenv(\"OPENAI_MODEL\", \"gpt-4.1-nano\")\n\n_INTENT_LABELS = {\n    \"real_estate\": \"Добавление объекта недвижимости\",\n    \"tu_application\": \"Заявление на технические условия\",\n}\n\n# ---------------------------------------------------------------------------\n# Static prompt prefix — identical across requests so OpenAI can cache it.\n# Dynamic sections (history, intent_context, step_control) are appended after.\n# ---------------------------------------------------------------------------\n\n_STATIC_PROMPT_RU = \"\"\"<role>\nТы — официальный ИИ-ассистент платформы iSEL.\nЯзык: русский.\n</role>\n\n<language_rule>\nЯзык пользователя: РУССКИЙ. Отвечай на русском языке.\n</language_rule>\n\n<intent_handling>\nПОШАГОВЫЕ ИНТЕНТЫ (заявление на ТУ):\n- Показывай ОДИН шаг за раз.\n- Текущий шаг передаётся явно в <step_control>. Не определяй шаг самостоятельно.\n- После шага 5 — не предлагай шаг 6 и не спрашивай о продолжении.\n\nСИТУАЦИОННЫЕ ИНТЕНТЫ (объект недвижимости):\n- Не выдавай все ситуации сразу.\n- Если пользователь спрашивает «как добавить объект» — задай ОДИН уточняющий вопрос:\n  «Вы хотите добавить объект через адресный регистр или через кадастровый номер?»\n- Если пользователь отвечает «через кадастр» / «кадастр аркылы» / «по кадастру» —\n  это ВЫБОР СПОСОБА ДОБАВЛЕНИЯ, а не вопрос о кадастровом номере.\n  Дай инструкцию по добавлению объекта через кадастровый номер:\n  укажите номер в поле → «Отправить запрос» → проверка собственника → «Обновить».\n- Если пользователь отвечает «через адресный регистр» / «адрес аркылы» —\n  дай инструкцию по добавлению через адресный регистр.\n- Только если пользователь ЯВНО спрашивает «как получить кадастровый номер» /\n  «где найти» / «как узнать» — дай источники:\n  правоустанавливающие документы, кадастровая справка, госакты, eGov.\n- НИКОГДА не придумывай новые уточняющие вопросы сверх указанных выше.\n\nОПРЕДЕЛЕНИЕ ФЛ/ЮЛ:\n- Тип пользователя передаётся в <intent_context>.\n- НИКОГДА не спрашивай пользователя о его типе лица повторно.\n</intent_handling>\n\n<navigation_facts>\nПодача заявки на ТУ: Личный кабинет → левое меню **Услуги** → категория **Электроснабжение** → услуга «Выдача технических условий на присоединение к электрическим сетям»\nДобавление объекта недвижимости: Личный кабинет → главная страница → блок **Объекты недвижимости** → кнопка **Добавить**\nСтатус заявки и готовые документы: Личный кабинет → **Услуги** → вкладка **Обращения**\nСкачать ТУ или мотивированный отказ: найти строку в таблице **Обращения** → нажать иконку **Скачать** или кнопку **Просмотр**\n</navigation_facts>\n\n<rules>\n1. Контекст извлечён из графа знаний платформы iSEL (LightRAG hybrid retrieval).\n2. Используй историю диалога для понимания текущего шага или ситуации.\n3. Найди в контексте ОДИН блок, соответствующий текущему шагу или ситуации.\n4. Воспроизведи шаблон ДОСЛОВНО — не перефразируй, не сокращай.\n5. Никогда не смешивай шаблоны из разных ситуаций или шагов.\n6. Если подходящего шаблона нет — ответь точно: «Не могу найти точный ответ. Рекомендую обратиться к оператору: **+7 775 990 15 36**». Никогда не дополняй ответ из собственных знаний.\n7. Никогда не начинай ответ со слов «Шаблон ответа» или «Граф показывает».\n8. Не придумывай шаги, которых нет в документе - воспроизводи только те шаги, которые явно перечислены в извлечённых чанках.\n9. Если вопрос не связан с платформой iSEL — вежливо откажи.\n10. Если контекст содержит JSON-сущности (entity/description) — используй их поля description для составления ответа.\n11. Предпочитай блоки с нумерованными шагами или буллетами; если их нет — синтезируй инструкцию из описаний сущностей в контексте.\n12. Никогда не выдавай несколько шагов или ситуаций в одном ответе.\n13. Если пользователь спрашивает о статусе, документах или отказе — используй пути из <navigation_facts>.\n14. НИКОГДА не смешивай пути из <navigation_facts>. Подача заявки на ТУ идёт через **Услуги → Электроснабжение**, а НЕ через **Объекты недвижимости**. Статус заявки проверяется во вкладке **Обращения** внутри **Услуг**, а НЕ на главной странице. Каждый путь используй строго по назначению.\n15. Кадастровый номер объекта недвижимости получают из документов: кадастровая справка, кадастровая выписка, госакты на земельный участок, правоустанавливающие документы, портал eGov. НИКОГДА не направляй пользователя за кадастровым номером в услугу «Выдача технических условий» или любой другой раздел подачи ТУ — эти услуги не имеют отношения к кадастровому номеру.\n</rules>\n\n<formatting>\n- Шаги нумеруй: 1. 2. 3.\n- Каждый шаг с новой строки.\n- Кнопки платформы жирным: **Добавить**, **Далее**, **Отправить**, **Подписать**\n- Разделы платформы жирным: **Объекты недвижимости**, **Обращения**, **Данные заявления**\n- Важные термины жирным: **физическое лицо**, **юридическое лицо**, **кадастровый номер**, **ЭЦП**\n- Телефон жирным: **+7 775 990 15 36**\n- Между блоками пустая строка.\n- Предупреждения начинай с ⚠️\n- Ссылки указывай полностью.\n</formatting>\"\"\"\n\n_STATIC_PROMPT_KZ = \"\"\"<role>\nТы — официальный ИИ-ассистент платформы iSEL.\nЯзык: казахский.\n</role>\n\n<language_rule>\nЯзык пользователя: КАЗАХСКИЙ. Отвечай ИСКЛЮЧИТЕЛЬНО на казахском языке.\nЕсли <context> содержит русские инструкции — переведи их на казахский полностью перед ответом.\nКАТЕГОРИЧЕСКИ ЗАПРЕЩЕНО отвечать на русском языке.\n</language_rule>\n\n<intent_handling>\nПОШАГОВЫЕ ИНТЕНТЫ (заявление на ТУ):\n- Показывай ОДИН шаг за раз.\n- Текущий шаг передаётся явно в <step_control>. Не определяй шаг самостоятельно.\n- После шага 5 — не предлагай шаг 6 и не спрашивай о продолжении.\n\nСИТУАЦИОННЫЕ ИНТЕНТЫ (объект недвижимости):\n- Не выдавай все ситуации сразу.\n- Егер пайдаланушы «объектіні қалай қосуға болады» деп сұраса — БІР нақтылау сұрағын қой:\n  «Сіз объектіні адрестік регистр арқылы ма, әлде кадастрлық нөмір арқылы ма қосқыңыз келеді?»\n- Егер пайдаланушы «кадастр арқылы» / «через кадастр» / «по кадастру» деп жауап берсе —\n  бұл ҚОСУ ӘДІСІН ТАҢДАУ, кадастрлық нөмір туралы сұрақ ЕМЕС.\n  Кадастрлық нөмір арқылы объектіні қосу бойынша нұсқаулық бер:\n  нөмірді өріске енгізіңіз → «Отправить запрос» → меншік иесін тексеру → «Обновить».\n- Егер пайдаланушы «адрес арқылы» / «адрестік регистр арқылы» деп жауап берсе —\n  адрестік регистр арқылы қосу бойынша нұсқаулық бер.\n- Тек егер пайдаланушы АНЫҚ «кадастрлық нөмірді қалай алуға болады» /\n  «қайдан табуға болады» / «қалай білуге болады» деп сұраса — көздерін айт:\n  құқық белгілейтін құжаттар, кадастрлық анықтама, мемлекеттік актілер, eGov.\n- ЕШҚАШАН жоғарыда көрсетілгендерден тыс жаңа нақтылау сұрақтарын ойлап таппа.\n\nОПРЕДЕЛЕНИЕ ФЛ/ЮЛ (ЖТ/ЗТ):\n- Тип пользователя передаётся в <intent_context>.\n- НИКОГДА не спрашивай пользователя о его типе лица повторно.\n</intent_handling>\n\n<navigation_facts>\nТШ-ға өтініш беру: Жеке кабинет → сол жақ мәзір **Қызметтер** → **Электрмен жабдықтау** санаты → «Электр желілеріне қосылуға техникалық шарттар беру» қызметі\nЖылжымайтын мүлік объектісін қосу: Жеке кабинет → басты бет → **Жылжымайтын мүлік объектілері** блогы → **Қосу** батырмасы\nӨтініш мәртебесі мен дайын құжаттар: Жеке кабинет → **Қызметтер** → **Өтініштер** қосымша беті\nТШ немесе дәлелді бас тартуды жүктеу: **Өтініштер** кестесіндегі жолды тауып → **Жүктеу** немесе **Қарау** батырмасын басу\n</navigation_facts>\n\n<rules>\n1. Контекст извлечён из графа знаний платформы iSEL (LightRAG hybrid retrieval).\n2. Используй историю диалога для понимания текущего шага или ситуации.\n3. Найди в контексте ОДИН блок, соответствующий текущему шагу или ситуации.\n4. Воспроизведи шаблон ДОСЛОВНО — переводя на казахский при необходимости.\n5. Никогда не смешивай шаблоны из разных ситуаций или шагов.\n6. Если подходящего шаблона нет — ответь: «Дәл жауап таба алмадым. Операторға хабарласыңыз: **+7 775 990 15 36**».\n7. Никогда не начинай ответ со слов «Жауап үлгісі» или «Граф показывает».\n8. Не придумывай шаги, которых нет в документе - воспроизводи только те шаги, которые явно перечислены в извлечённых чанках.\n9. Если вопрос не связан с платформой iSEL — вежливо откажи на казахском.\n10. Егер контекст JSON-сущности (entity/description) болса — description өрістерін жауап жасауға пайдалан.\n11. Нөмірленген қадамдары бар блоктарды қолдан; олар жоқ болса — контекстегі сущность сипаттамаларынан нұсқаулық жаса.\n12. Никогда не выдавай несколько шагов или ситуаций в одном ответе.\n13. Егер пайдаланушы мәртебе, құжат немесе бас тарту туралы сұраса — <navigation_facts> жолдарын пайдалан.\n14. ЕШҚАШАН <navigation_facts> жолдарын араластырма. ТШ-ға өтініш беру **Қызметтер → Электрмен жабдықтау** арқылы жүреді, **Жылжымайтын мүлік объектілері** арқылы ЕМЕС. Өтініш мәртебесі **Қызметтер** ішіндегі **Өтініштер** бетінде тексеріледі, басты бетте ЕМЕС. Әр жолды тек өз мақсаты бойынша пайдалан.\n15. Жылжымайтын мүлік объектісінің кадастрлық нөмірі құжаттардан алынады: кадастрлық анықтама, кадастрлық үзінді, жер учаскесіне мемлекеттік акт, құқық белгілейтін құжаттар, eGov порталы. ЕШҚАШАН пайдаланушыны кадастрлық нөмір алу үшін «Техникалық шарттар беру» қызметіне немесе ТШ берумен байланысты кез келген бөлімге бағыттама — бұл қызметтердің кадастрлық нөмірге қатысы жоқ.\n</rules>\n\n<formatting>\n- Шаги нумеруй: 1. 2. 3.\n- Каждый шаг с новой строки.\n- Кнопки платформы жирным: **Қосу**, **Әрі қарай**, **Жіберу**, **Қол қою**\n- Важные термины жирным: **жеке тұлға**, **заңды тұлға**, **кадастрлық нөмір**, **ЭЦҚ**\n- Телефон жирным: **+7 775 990 15 36**\n- Между блоками пустая строка.\n- Предупреждения начинай с ⚠️\n</formatting>\"\"\"\n\n\ndef _build_system_prompt(\n    language: str,\n    history: str,\n    intent: Optional[str],\n    entity: Optional[str],\n    current_step: Optional[int],\n    page: Optional[str],\n    situation: Optional[str] = None,\n) -> str:\n    static = _STATIC_PROMPT_KZ if language == \"kz\" else _STATIC_PROMPT_RU\n    dynamic_parts: list[str] = []\n\n    if history:\n        dynamic_parts.append(f\"<history>\\n{history}\\n</history>\")\n\n    if intent or entity or page:\n        intent_label = _INTENT_LABELS.get(intent or \"\", \"не определён\")\n        dynamic_parts.append(\n            f\"<intent_context>\\n\"\n            f\"Интент: {intent_label}\\n\"\n            f\"Тип пользователя: {entity or 'не определено'}\\n\"\n            f\"Страница: {page or 'не указана'}\\n\"\n            f\"</intent_context>\"\n        )\n\n    if current_step is not None:\n        next_step = current_step + 1\n        if current_step < 5:\n            if language == \"kz\":\n                step_note = (\n                    \"После инструкции добавь: «Барлық міндетті өрістерді толтырғаннан кейін \"\n                    \"келесі қадамға өту үшін **Әрі қарай** батырмасын басыңыз.»\"\n                )\n            else:\n                step_note = (\n                    \"После инструкции добавь: «После заполнения всех обязательных полей \"\n                    \"нажмите кнопку **Далее**, чтобы перейти к следующему шагу.»\"\n                )\n        else:\n            step_note = (\n                \"Это ПОСЛЕДНИЙ шаг. Дай инструкцию по подписи и отправке. НИКОГДА не предлагай шаг 6. \"\n                \"После инструкции добавь: «После отправки статус заявки и готовые ТУ появятся в \"\n                \"**Личный кабинет → Услуги → вкладка Обращения**.»\"\n            )\n        dynamic_parts.append(\n            f\"<step_control>\\n\"\n            f\"Текущий шаг: {current_step} из 5\\n\"\n            f\"Отвечай СТРОГО по шагу {current_step}. Не включай другие шаги.\\n\"\n            f\"{step_note}\\n\"\n            f\"</step_control>\"\n        )\n\n    if dynamic_parts:\n        return static + \"\\n\\n\" + \"\\n\\n\".join(dynamic_parts)\n    return static\n\n\n# ---------------------------------------------------------------------------\n# Public interface\n# ---------------------------------------------------------------------------\n\nasync def ask_llm(\n    question: str,\n    context: str,\n    page: Optional[str] = None,\n    language: str = \"ru\",\n    history: str = \"\",\n    intent: Optional[str] = None,\n    entity: Optional[str] = None,\n    current_step: Optional[int] = None,\n) -> str:\n    system = _build_system_prompt(\n        language=language,\n        history=history,\n        intent=intent,\n        entity=entity,\n        current_step=current_step,\n        page=page,\n    )\n    prompt = f\"<context>\\n{context}\\n</context>\\n\\n<question>\\n{question}\\n</question>\\n\\n<answer>\"\n\n    if LLM_PROVIDER == \"openai\":\n        return await _call_openai(system, prompt)\n    return await _call_ollama(system, prompt)\n\n\n# ---------------------------------------------------------------------------\n# Provider implementations\n# ---------------------------------------------------------------------------\n\nasync def _call_openai(system: str, prompt: str) -> str:\n    async with httpx.AsyncClient(timeout=30.0) as client:\n        try:\n            response = await client.post(\n                \"https://api.openai.com/v1/chat/completions\",\n                headers={\n                    \"Authorization\": f\"Bearer {OPENAI_API_KEY}\",\n                    \"Content-Type\": \"application/json\",\n                },\n                json={\n                    \"model\": OPENAI_MODEL,\n                    \"messages\": [\n                        {\"role\": \"system\", \"content\": system},\n                        {\"role\": \"user\", \"content\": prompt},\n                    ],\n                    \"temperature\": 0.0,\n                    \"max_tokens\": 1000,\n                },\n            )\n            data = response.json()\n            if response.status_code != 200:\n                error_msg = data.get(\"error\", {}).get(\"message\", \"Unknown error\")\n                return f\"Ошибка OpenAI: {error_msg}\"\n            return data[\"choices\"][0][\"message\"][\"content\"]\n        except Exception as e:\n            return f\"Ошибка LLM-сервиса: {str(e)}\"\n\n\nasync def _call_ollama(system: str, prompt: str) -> str:\n    async with httpx.AsyncClient(timeout=180.0) as client:\n        try:\n            response = await client.post(\n                f\"{OLLAMA_BASE_URL}/api/generate\",\n                json={\n                    \"model\": OLLAMA_MODEL,\n                    \"prompt\": prompt,\n                    \"system\": system,\n                    \"stream\": False,\n                    \"options\": {\"temperature\": 0.0},\n                },\n            )\n            data = response.json()\n            return data.get(\"response\", \"Ошибка генерации.\")\n        except Exception as e:\n            return f\"Ошибка LLM-сервиса: {str(e)}\"\n","structuredPatch":[{"oldStart":183,"oldLines":14,"newStart":183,"newLines":17,"lines":["     if history:","         dynamic_parts.append(f\"<history>\\n{history}\\n</history>\")"," ","-    if intent or entity or page:","+    if intent or entity or page or situation:","         intent_label = _INTENT_LABELS.get(intent or \"\", \"не определён\")","+        ctx_lines = [","+            f\"Интент: {intent_label}\",","+            f\"Тип пользователя: {entity or 'не определено'}\",","+            f\"Страница: {page or 'не указана'}\",","+        ]","+        if situation:","+            ctx_lines.append(f\"Выбранная ситуация: {situation}\")","         dynamic_parts.append(","-            f\"<intent_context>\\n\"","-            f\"Интент: {intent_label}\\n\"","-            f\"Тип пользователя: {entity or 'не определено'}\\n\"","-            f\"Страница: {page or 'не указана'}\\n\"","-            f\"</intent_context>\"","+            \"<intent_context>\\n\" + \"\\n\".join(ctx_lines) + \"\\n</intent_context>\"","         )"," ","     if current_step is not None:"]}],"userModified":false,"replaceAll":false},"tool_use_id":"toolu_01QJxBK3CWJGzvQBdhvEgPUN","duration_ms":4}

2026-05-13T21:03:27.481Z {"session_id":"41f2eab1-8bcc-4841-8211-32ca523860b0","transcript_path":"C:\\Users\\yasmi\\.claude\\projects\\e--workstuff-platform-ai-assistant\\41f2eab1-8bcc-4841-8211-32ca523860b0.jsonl","cwd":"e:\\workstuff\\platform_ai_assistant","permission_mode":"acceptEdits","effort":{"level":"medium"},"hook_event_name":"PreToolUse","tool_name":"Edit","tool_input":{"file_path":"e:\\workstuff\\platform_ai_assistant\\app\\services\\llm_service.py","old_string":"async def ask_llm(\n    question: str,\n    context: str,\n    page: Optional[str] = None,\n    language: str = \"ru\",\n    history: str = \"\",\n    intent: Optional[str] = None,\n    entity: Optional[str] = None,\n    current_step: Optional[int] = None,\n) -> str:\n    system = _build_system_prompt(\n        language=language,\n        history=history,\n        intent=intent,\n        entity=entity,\n        current_step=current_step,\n        page=page,\n    )","new_string":"async def ask_llm(\n    question: str,\n    context: str,\n    page: Optional[str] = None,\n    language: str = \"ru\",\n    history: str = \"\",\n    intent: Optional[str] = None,\n    entity: Optional[str] = None,\n    current_step: Optional[int] = None,\n    situation: Optional[str] = None,\n) -> str:\n    system = _build_system_prompt(\n        language=language,\n        history=history,\n        intent=intent,\n        entity=entity,\n        current_step=current_step,\n        page=page,\n        situation=situation,\n    )","replace_all":false},"tool_use_id":"toolu_01Jz3tes9z5BFFVZonHLe1YF"}

2026-05-13T21:03:27.939Z {"session_id":"41f2eab1-8bcc-4841-8211-32ca523860b0","transcript_path":"C:\\Users\\yasmi\\.claude\\projects\\e--workstuff-platform-ai-assistant\\41f2eab1-8bcc-4841-8211-32ca523860b0.jsonl","cwd":"e:\\workstuff\\platform_ai_assistant","permission_mode":"acceptEdits","effort":{"level":"medium"},"hook_event_name":"PostToolUse","tool_name":"Edit","tool_input":{"file_path":"e:\\workstuff\\platform_ai_assistant\\app\\services\\llm_service.py","old_string":"async def ask_llm(\n    question: str,\n    context: str,\n    page: Optional[str] = None,\n    language: str = \"ru\",\n    history: str = \"\",\n    intent: Optional[str] = None,\n    entity: Optional[str] = None,\n    current_step: Optional[int] = None,\n) -> str:\n    system = _build_system_prompt(\n        language=language,\n        history=history,\n        intent=intent,\n        entity=entity,\n        current_step=current_step,\n        page=page,\n    )","new_string":"async def ask_llm(\n    question: str,\n    context: str,\n    page: Optional[str] = None,\n    language: str = \"ru\",\n    history: str = \"\",\n    intent: Optional[str] = None,\n    entity: Optional[str] = None,\n    current_step: Optional[int] = None,\n    situation: Optional[str] = None,\n) -> str:\n    system = _build_system_prompt(\n        language=language,\n        history=history,\n        intent=intent,\n        entity=entity,\n        current_step=current_step,\n        page=page,\n        situation=situation,\n    )","replace_all":false},"tool_response":{"filePath":"e:\\workstuff\\platform_ai_assistant\\app\\services\\llm_service.py","oldString":"async def ask_llm(\n    question: str,\n    context: str,\n    page: Optional[str] = None,\n    language: str = \"ru\",\n    history: str = \"\",\n    intent: Optional[str] = None,\n    entity: Optional[str] = None,\n    current_step: Optional[int] = None,\n) -> str:\n    system = _build_system_prompt(\n        language=language,\n        history=history,\n        intent=intent,\n        entity=entity,\n        current_step=current_step,\n        page=page,\n    )","newString":"async def ask_llm(\n    question: str,\n    context: str,\n    page: Optional[str] = None,\n    language: str = \"ru\",\n    history: str = \"\",\n    intent: Optional[str] = None,\n    entity: Optional[str] = None,\n    current_step: Optional[int] = None,\n    situation: Optional[str] = None,\n) -> str:\n    system = _build_system_prompt(\n        language=language,\n        history=history,\n        intent=intent,\n        entity=entity,\n        current_step=current_step,\n        page=page,\n        situation=situation,\n    )","originalFile":"from __future__ import annotations\n\nimport httpx\nimport os\nfrom typing import Optional\nfrom dotenv import load_dotenv\n\nload_dotenv()\n\nLLM_PROVIDER = os.getenv(\"LLM_PROVIDER\", \"openai\")\nOLLAMA_BASE_URL = os.getenv(\"OLLAMA_BASE_URL\", \"http://localhost:11434\")\nOLLAMA_MODEL = os.getenv(\"OLLAMA_MODEL\", \"llama3.2\")\nOPENAI_API_KEY = os.getenv(\"OPENAI_API_KEY\", \"\")\nOPENAI_MODEL = os.getenv(\"OPENAI_MODEL\", \"gpt-4.1-nano\")\n\n_INTENT_LABELS = {\n    \"real_estate\": \"Добавление объекта недвижимости\",\n    \"tu_application\": \"Заявление на технические условия\",\n}\n\n# ---------------------------------------------------------------------------\n# Static prompt prefix — identical across requests so OpenAI can cache it.\n# Dynamic sections (history, intent_context, step_control) are appended after.\n# ---------------------------------------------------------------------------\n\n_STATIC_PROMPT_RU = \"\"\"<role>\nТы — официальный ИИ-ассистент платформы iSEL.\nЯзык: русский.\n</role>\n\n<language_rule>\nЯзык пользователя: РУССКИЙ. Отвечай на русском языке.\n</language_rule>\n\n<intent_handling>\nПОШАГОВЫЕ ИНТЕНТЫ (заявление на ТУ):\n- Показывай ОДИН шаг за раз.\n- Текущий шаг передаётся явно в <step_control>. Не определяй шаг самостоятельно.\n- После шага 5 — не предлагай шаг 6 и не спрашивай о продолжении.\n\nСИТУАЦИОННЫЕ ИНТЕНТЫ (объект недвижимости):\n- Не выдавай все ситуации сразу.\n- Если пользователь спрашивает «как добавить объект» — задай ОДИН уточняющий вопрос:\n  «Вы хотите добавить объект через адресный регистр или через кадастровый номер?»\n- Если пользователь отвечает «через кадастр» / «кадастр аркылы» / «по кадастру» —\n  это ВЫБОР СПОСОБА ДОБАВЛЕНИЯ, а не вопрос о кадастровом номере.\n  Дай инструкцию по добавлению объекта через кадастровый номер:\n  укажите номер в поле → «Отправить запрос» → проверка собственника → «Обновить».\n- Если пользователь отвечает «через адресный регистр» / «адрес аркылы» —\n  дай инструкцию по добавлению через адресный регистр.\n- Только если пользователь ЯВНО спрашивает «как получить кадастровый номер» /\n  «где найти» / «как узнать» — дай источники:\n  правоустанавливающие документы, кадастровая справка, госакты, eGov.\n- НИКОГДА не придумывай новые уточняющие вопросы сверх указанных выше.\n\nОПРЕДЕЛЕНИЕ ФЛ/ЮЛ:\n- Тип пользователя передаётся в <intent_context>.\n- НИКОГДА не спрашивай пользователя о его типе лица повторно.\n</intent_handling>\n\n<navigation_facts>\nПодача заявки на ТУ: Личный кабинет → левое меню **Услуги** → категория **Электроснабжение** → услуга «Выдача технических условий на присоединение к электрическим сетям»\nДобавление объекта недвижимости: Личный кабинет → главная страница → блок **Объекты недвижимости** → кнопка **Добавить**\nСтатус заявки и готовые документы: Личный кабинет → **Услуги** → вкладка **Обращения**\nСкачать ТУ или мотивированный отказ: найти строку в таблице **Обращения** → нажать иконку **Скачать** или кнопку **Просмотр**\n</navigation_facts>\n\n<rules>\n1. Контекст извлечён из графа знаний платформы iSEL (LightRAG hybrid retrieval).\n2. Используй историю диалога для понимания текущего шага или ситуации.\n3. Найди в контексте ОДИН блок, соответствующий текущему шагу или ситуации.\n4. Воспроизведи шаблон ДОСЛОВНО — не перефразируй, не сокращай.\n5. Никогда не смешивай шаблоны из разных ситуаций или шагов.\n6. Если подходящего шаблона нет — ответь точно: «Не могу найти точный ответ. Рекомендую обратиться к оператору: **+7 775 990 15 36**». Никогда не дополняй ответ из собственных знаний.\n7. Никогда не начинай ответ со слов «Шаблон ответа» или «Граф показывает».\n8. Не придумывай шаги, которых нет в документе - воспроизводи только те шаги, которые явно перечислены в извлечённых чанках.\n9. Если вопрос не связан с платформой iSEL — вежливо откажи.\n10. Если контекст содержит JSON-сущности (entity/description) — используй их поля description для составления ответа.\n11. Предпочитай блоки с нумерованными шагами или буллетами; если их нет — синтезируй инструкцию из описаний сущностей в контексте.\n12. Никогда не выдавай несколько шагов или ситуаций в одном ответе.\n13. Если пользователь спрашивает о статусе, документах или отказе — используй пути из <navigation_facts>.\n14. НИКОГДА не смешивай пути из <navigation_facts>. Подача заявки на ТУ идёт через **Услуги → Электроснабжение**, а НЕ через **Объекты недвижимости**. Статус заявки проверяется во вкладке **Обращения** внутри **Услуг**, а НЕ на главной странице. Каждый путь используй строго по назначению.\n15. Кадастровый номер объекта недвижимости получают из документов: кадастровая справка, кадастровая выписка, госакты на земельный участок, правоустанавливающие документы, портал eGov. НИКОГДА не направляй пользователя за кадастровым номером в услугу «Выдача технических условий» или любой другой раздел подачи ТУ — эти услуги не имеют отношения к кадастровому номеру.\n</rules>\n\n<formatting>\n- Шаги нумеруй: 1. 2. 3.\n- Каждый шаг с новой строки.\n- Кнопки платформы жирным: **Добавить**, **Далее**, **Отправить**, **Подписать**\n- Разделы платформы жирным: **Объекты недвижимости**, **Обращения**, **Данные заявления**\n- Важные термины жирным: **физическое лицо**, **юридическое лицо**, **кадастровый номер**, **ЭЦП**\n- Телефон жирным: **+7 775 990 15 36**\n- Между блоками пустая строка.\n- Предупреждения начинай с ⚠️\n- Ссылки указывай полностью.\n</formatting>\"\"\"\n\n_STATIC_PROMPT_KZ = \"\"\"<role>\nТы — официальный ИИ-ассистент платформы iSEL.\nЯзык: казахский.\n</role>\n\n<language_rule>\nЯзык пользователя: КАЗАХСКИЙ. Отвечай ИСКЛЮЧИТЕЛЬНО на казахском языке.\nЕсли <context> содержит русские инструкции — переведи их на казахский полностью перед ответом.\nКАТЕГОРИЧЕСКИ ЗАПРЕЩЕНО отвечать на русском языке.\n</language_rule>\n\n<intent_handling>\nПОШАГОВЫЕ ИНТЕНТЫ (заявление на ТУ):\n- Показывай ОДИН шаг за раз.\n- Текущий шаг передаётся явно в <step_control>. Не определяй шаг самостоятельно.\n- После шага 5 — не предлагай шаг 6 и не спрашивай о продолжении.\n\nСИТУАЦИОННЫЕ ИНТЕНТЫ (объект недвижимости):\n- Не выдавай все ситуации сразу.\n- Егер пайдаланушы «объектіні қалай қосуға болады» деп сұраса — БІР нақтылау сұрағын қой:\n  «Сіз объектіні адрестік регистр арқылы ма, әлде кадастрлық нөмір арқылы ма қосқыңыз келеді?»\n- Егер пайдаланушы «кадастр арқылы» / «через кадастр» / «по кадастру» деп жауап берсе —\n  бұл ҚОСУ ӘДІСІН ТАҢДАУ, кадастрлық нөмір туралы сұрақ ЕМЕС.\n  Кадастрлық нөмір арқылы объектіні қосу бойынша нұсқаулық бер:\n  нөмірді өріске енгізіңіз → «Отправить запрос» → меншік иесін тексеру → «Обновить».\n- Егер пайдаланушы «адрес арқылы» / «адрестік регистр арқылы» деп жауап берсе —\n  адрестік регистр арқылы қосу бойынша нұсқаулық бер.\n- Тек егер пайдаланушы АНЫҚ «кадастрлық нөмірді қалай алуға болады» /\n  «қайдан табуға болады» / «қалай білуге болады» деп сұраса — көздерін айт:\n  құқық белгілейтін құжаттар, кадастрлық анықтама, мемлекеттік актілер, eGov.\n- ЕШҚАШАН жоғарыда көрсетілгендерден тыс жаңа нақтылау сұрақтарын ойлап таппа.\n\nОПРЕДЕЛЕНИЕ ФЛ/ЮЛ (ЖТ/ЗТ):\n- Тип пользователя передаётся в <intent_context>.\n- НИКОГДА не спрашивай пользователя о его типе лица повторно.\n</intent_handling>\n\n<navigation_facts>\nТШ-ға өтініш беру: Жеке кабинет → сол жақ мәзір **Қызметтер** → **Электрмен жабдықтау** санаты → «Электр желілеріне қосылуға техникалық шарттар беру» қызметі\nЖылжымайтын мүлік объектісін қосу: Жеке кабинет → басты бет → **Жылжымайтын мүлік объектілері** блогы → **Қосу** батырмасы\nӨтініш мәртебесі мен дайын құжаттар: Жеке кабинет → **Қызметтер** → **Өтініштер** қосымша беті\nТШ немесе дәлелді бас тартуды жүктеу: **Өтініштер** кестесіндегі жолды тауып → **Жүктеу** немесе **Қарау** батырмасын басу\n</navigation_facts>\n\n<rules>\n1. Контекст извлечён из графа знаний платформы iSEL (LightRAG hybrid retrieval).\n2. Используй историю диалога для понимания текущего шага или ситуации.\n3. Найди в контексте ОДИН блок, соответствующий текущему шагу или ситуации.\n4. Воспроизведи шаблон ДОСЛОВНО — переводя на казахский при необходимости.\n5. Никогда не смешивай шаблоны из разных ситуаций или шагов.\n6. Если подходящего шаблона нет — ответь: «Дәл жауап таба алмадым. Операторға хабарласыңыз: **+7 775 990 15 36**».\n7. Никогда не начинай ответ со слов «Жауап үлгісі» или «Граф показывает».\n8. Не придумывай шаги, которых нет в документе - воспроизводи только те шаги, которые явно перечислены в извлечённых чанках.\n9. Если вопрос не связан с платформой iSEL — вежливо откажи на казахском.\n10. Егер контекст JSON-сущности (entity/description) болса — description өрістерін жауап жасауға пайдалан.\n11. Нөмірленген қадамдары бар блоктарды қолдан; олар жоқ болса — контекстегі сущность сипаттамаларынан нұсқаулық жаса.\n12. Никогда не выдавай несколько шагов или ситуаций в одном ответе.\n13. Егер пайдаланушы мәртебе, құжат немесе бас тарту туралы сұраса — <navigation_facts> жолдарын пайдалан.\n14. ЕШҚАШАН <navigation_facts> жолдарын араластырма. ТШ-ға өтініш беру **Қызметтер → Электрмен жабдықтау** арқылы жүреді, **Жылжымайтын мүлік объектілері** арқылы ЕМЕС. Өтініш мәртебесі **Қызметтер** ішіндегі **Өтініштер** бетінде тексеріледі, басты бетте ЕМЕС. Әр жолды тек өз мақсаты бойынша пайдалан.\n15. Жылжымайтын мүлік объектісінің кадастрлық нөмірі құжаттардан алынады: кадастрлық анықтама, кадастрлық үзінді, жер учаскесіне мемлекеттік акт, құқық белгілейтін құжаттар, eGov порталы. ЕШҚАШАН пайдаланушыны кадастрлық нөмір алу үшін «Техникалық шарттар беру» қызметіне немесе ТШ берумен байланысты кез келген бөлімге бағыттама — бұл қызметтердің кадастрлық нөмірге қатысы жоқ.\n</rules>\n\n<formatting>\n- Шаги нумеруй: 1. 2. 3.\n- Каждый шаг с новой строки.\n- Кнопки платформы жирным: **Қосу**, **Әрі қарай**, **Жіберу**, **Қол қою**\n- Важные термины жирным: **жеке тұлға**, **заңды тұлға**, **кадастрлық нөмір**, **ЭЦҚ**\n- Телефон жирным: **+7 775 990 15 36**\n- Между блоками пустая строка.\n- Предупреждения начинай с ⚠️\n</formatting>\"\"\"\n\n\ndef _build_system_prompt(\n    language: str,\n    history: str,\n    intent: Optional[str],\n    entity: Optional[str],\n    current_step: Optional[int],\n    page: Optional[str],\n    situation: Optional[str] = None,\n) -> str:\n    static = _STATIC_PROMPT_KZ if language == \"kz\" else _STATIC_PROMPT_RU\n    dynamic_parts: list[str] = []\n\n    if history:\n        dynamic_parts.append(f\"<history>\\n{history}\\n</history>\")\n\n    if intent or entity or page or situation:\n        intent_label = _INTENT_LABELS.get(intent or \"\", \"не определён\")\n        ctx_lines = [\n            f\"Интент: {intent_label}\",\n            f\"Тип пользователя: {entity or 'не определено'}\",\n            f\"Страница: {page or 'не указана'}\",\n        ]\n        if situation:\n            ctx_lines.append(f\"Выбранная ситуация: {situation}\")\n        dynamic_parts.append(\n            \"<intent_context>\\n\" + \"\\n\".join(ctx_lines) + \"\\n</intent_context>\"\n        )\n\n    if current_step is not None:\n        next_step = current_step + 1\n        if current_step < 5:\n            if language == \"kz\":\n                step_note = (\n                    \"После инструкции добавь: «Барлық міндетті өрістерді толтырғаннан кейін \"\n                    \"келесі қадамға өту үшін **Әрі қарай** батырмасын басыңыз.»\"\n                )\n            else:\n                step_note = (\n                    \"После инструкции добавь: «После заполнения всех обязательных полей \"\n                    \"нажмите кнопку **Далее**, чтобы перейти к следующему шагу.»\"\n                )\n        else:\n            step_note = (\n                \"Это ПОСЛЕДНИЙ шаг. Дай инструкцию по подписи и отправке. НИКОГДА не предлагай шаг 6. \"\n                \"После инструкции добавь: «После отправки статус заявки и готовые ТУ появятся в \"\n                \"**Личный кабинет → Услуги → вкладка Обращения**.»\"\n            )\n        dynamic_parts.append(\n            f\"<step_control>\\n\"\n            f\"Текущий шаг: {current_step} из 5\\n\"\n            f\"Отвечай СТРОГО по шагу {current_step}. Не включай другие шаги.\\n\"\n            f\"{step_note}\\n\"\n            f\"</step_control>\"\n        )\n\n    if dynamic_parts:\n        return static + \"\\n\\n\" + \"\\n\\n\".join(dynamic_parts)\n    return static\n\n\n# ---------------------------------------------------------------------------\n# Public interface\n# ---------------------------------------------------------------------------\n\nasync def ask_llm(\n    question: str,\n    context: str,\n    page: Optional[str] = None,\n    language: str = \"ru\",\n    history: str = \"\",\n    intent: Optional[str] = None,\n    entity: Optional[str] = None,\n    current_step: Optional[int] = None,\n) -> str:\n    system = _build_system_prompt(\n        language=language,\n        history=history,\n        intent=intent,\n        entity=entity,\n        current_step=current_step,\n        page=page,\n    )\n    prompt = f\"<context>\\n{context}\\n</context>\\n\\n<question>\\n{question}\\n</question>\\n\\n<answer>\"\n\n    if LLM_PROVIDER == \"openai\":\n        return await _call_openai(system, prompt)\n    return await _call_ollama(system, prompt)\n\n\n# ---------------------------------------------------------------------------\n# Provider implementations\n# ---------------------------------------------------------------------------\n\nasync def _call_openai(system: str, prompt: str) -> str:\n    async with httpx.AsyncClient(timeout=30.0) as client:\n        try:\n            response = await client.post(\n                \"https://api.openai.com/v1/chat/completions\",\n                headers={\n                    \"Authorization\": f\"Bearer {OPENAI_API_KEY}\",\n                    \"Content-Type\": \"application/json\",\n                },\n                json={\n                    \"model\": OPENAI_MODEL,\n                    \"messages\": [\n                        {\"role\": \"system\", \"content\": system},\n                        {\"role\": \"user\", \"content\": prompt},\n                    ],\n                    \"temperature\": 0.0,\n                    \"max_tokens\": 1000,\n                },\n            )\n            data = response.json()\n            if response.status_code != 200:\n                error_msg = data.get(\"error\", {}).get(\"message\", \"Unknown error\")\n                return f\"Ошибка OpenAI: {error_msg}\"\n            return data[\"choices\"][0][\"message\"][\"content\"]\n        except Exception as e:\n            return f\"Ошибка LLM-сервиса: {str(e)}\"\n\n\nasync def _call_ollama(system: str, prompt: str) -> str:\n    async with httpx.AsyncClient(timeout=180.0) as client:\n        try:\n            response = await client.post(\n                f\"{OLLAMA_BASE_URL}/api/generate\",\n                json={\n                    \"model\": OLLAMA_MODEL,\n                    \"prompt\": prompt,\n                    \"system\": system,\n                    \"stream\": False,\n                    \"options\": {\"temperature\": 0.0},\n                },\n            )\n            data = response.json()\n            return data.get(\"response\", \"Ошибка генерации.\")\n        except Exception as e:\n            return f\"Ошибка LLM-сервиса: {str(e)}\"\n","structuredPatch":[{"oldStart":241,"oldLines":6,"newStart":241,"newLines":7,"lines":["     intent: Optional[str] = None,","     entity: Optional[str] = None,","     current_step: Optional[int] = None,","+    situation: Optional[str] = None,"," ) -> str:","     system = _build_system_prompt(","         language=language,"]},{"oldStart":249,"oldLines":6,"newStart":250,"newLines":7,"lines":["         entity=entity,","         current_step=current_step,","         page=page,","+        situation=situation,","     )","     prompt = f\"<context>\\n{context}\\n</context>\\n\\n<question>\\n{question}\\n</question>\\n\\n<answer>\""," "]}],"userModified":false,"replaceAll":false},"tool_use_id":"toolu_01Jz3tes9z5BFFVZonHLe1YF","duration_ms":4}

2026-05-13T21:03:33.571Z {"session_id":"41f2eab1-8bcc-4841-8211-32ca523860b0","transcript_path":"C:\\Users\\yasmi\\.claude\\projects\\e--workstuff-platform-ai-assistant\\41f2eab1-8bcc-4841-8211-32ca523860b0.jsonl","cwd":"e:\\workstuff\\platform_ai_assistant","permission_mode":"acceptEdits","effort":{"level":"medium"},"hook_event_name":"PreToolUse","tool_name":"Edit","tool_input":{"file_path":"e:\\workstuff\\platform_ai_assistant\\app\\routers\\chat.py","old_string":"    answer = await ask_llm(\n        _annotate_question(request.message, state.entity, lang),\n        context if context else \"Контекст недоступен.\",\n        page=request.page,\n        language=lang,\n        history=_build_history_text(history),\n        intent=state.intent,\n        entity=state.entity,\n        current_step=state.step,\n    )","new_string":"    answer = await ask_llm(\n        _annotate_question(request.message, state.entity, lang),\n        context if context else \"Контекст недоступен.\",\n        page=request.page,\n        language=lang,\n        history=_build_history_text(history),\n        intent=state.intent,\n        entity=state.entity,\n        current_step=state.step,\n        situation=state.situation,\n    )","replace_all":false},"tool_use_id":"toolu_01EFh57cyrTZywxZYiAgQELE"}

2026-05-13T21:03:34.065Z {"session_id":"41f2eab1-8bcc-4841-8211-32ca523860b0","transcript_path":"C:\\Users\\yasmi\\.claude\\projects\\e--workstuff-platform-ai-assistant\\41f2eab1-8bcc-4841-8211-32ca523860b0.jsonl","cwd":"e:\\workstuff\\platform_ai_assistant","permission_mode":"acceptEdits","effort":{"level":"medium"},"hook_event_name":"PostToolUse","tool_name":"Edit","tool_input":{"file_path":"e:\\workstuff\\platform_ai_assistant\\app\\routers\\chat.py","old_string":"    answer = await ask_llm(\n        _annotate_question(request.message, state.entity, lang),\n        context if context else \"Контекст недоступен.\",\n        page=request.page,\n        language=lang,\n        history=_build_history_text(history),\n        intent=state.intent,\n        entity=state.entity,\n        current_step=state.step,\n    )","new_string":"    answer = await ask_llm(\n        _annotate_question(request.message, state.entity, lang),\n        context if context else \"Контекст недоступен.\",\n        page=request.page,\n        language=lang,\n        history=_build_history_text(history),\n        intent=state.intent,\n        entity=state.entity,\n        current_step=state.step,\n        situation=state.situation,\n    )","replace_all":false},"tool_response":{"filePath":"e:\\workstuff\\platform_ai_assistant\\app\\routers\\chat.py","oldString":"    answer = await ask_llm(\n        _annotate_question(request.message, state.entity, lang),\n        context if context else \"Контекст недоступен.\",\n        page=request.page,\n        language=lang,\n        history=_build_history_text(history),\n        intent=state.intent,\n        entity=state.entity,\n        current_step=state.step,\n    )","newString":"    answer = await ask_llm(\n        _annotate_question(request.message, state.entity, lang),\n        context if context else \"Контекст недоступен.\",\n        page=request.page,\n        language=lang,\n        history=_build_history_text(history),\n        intent=state.intent,\n        entity=state.entity,\n        current_step=state.step,\n        situation=state.situation,\n    )","originalFile":"from __future__ import annotations\n\nfrom typing import Optional\n\nfrom fastapi import APIRouter\n\nfrom app.flows.base import FlowContext\nfrom app.flows.faq import FAQFlow\nfrom app.flows.registry import classify_intent, get_flow, has_flow_keywords\nfrom app.models.schemas import ChatRequest, ChatResponse, FlowState\nfrom app.services.llm_service import ask_llm\nfrom app.services.rag import search_docs\nfrom app.services.rate_limit import chat_limiter\nfrom app.services.rulebased import check_rule\nfrom app.services.session import sessions\nfrom app.services.translit import normalize_kz\nfrom app.services.validation import ValidationError, validate_message, validate_session_id\nfrom app.utils.logger import log_chat_request\n\nrouter = APIRouter()\n\n# ---------------------------------------------------------------------------\n# Constants — entity detection\n# ---------------------------------------------------------------------------\n\n_KZ_CHARS = frozenset(\"әғқңөұүіӘҒҚҢӨҰҮІ\")\n\n# Platform-specific entity abbreviations used only in Kazakh context.\n# They contain no KZ-specific chars so history-walk can't help when the\n# clarification gate fired (update_state_only skips history), so we\n# treat them as an unconditional KZ signal.\n_KZ_ENTITY_EXACT = frozenset({\"жт\", \"зт\", \"ж.т.\", \"з.т.\"})\n\n_FL_PHRASES = [\n    \"физическое лицо\", \"физ лицо\", \"физлицо\",\n    \"физического лица\", \"физическим лицом\",\n    \"жеке тұлға\", \"жеке тулга\",\n    \"я фл\", \"как фл\", \"я ип\",\n]\n_UL_PHRASES = [\n    \"юридическое лицо\", \"юр лицо\", \"юрлицо\",\n    \"юридического лица\", \"юридическим лицом\",\n    \"заңды тұлға\", \"занды тулга\",\n    \"я юл\", \"как юл\",\n    \" бин \", \"наша организация\", \"наша компания\",\n]\n_FL_EXACT = frozenset({\"фл\", \"ф.л.\", \"физ\", \"физлицо\", \"физ лицо\", \"жт\", \"ж.т.\"})\n_UL_EXACT = frozenset({\"юл\", \"ю.л.\", \"юр\", \"юрлицо\", \"юр лицо\", \"зт\", \"з.т.\"})\n\n# Steps that are shared between FL and UL — entity clarification not needed\n_SHARED_STEPS = frozenset({\"шаг 2\", \"шаг 3\", \"шаг 4\", \"шаг 5\"})\n\n# ---------------------------------------------------------------------------\n# Pure helpers\n# ---------------------------------------------------------------------------\n\ndef _detect_language(message: str, history: list[dict] | None = None) -> str:\n    if any(ch in _KZ_CHARS for ch in message):\n        return \"kz\"\n    # KZ entity abbreviations (ЖТ/ЗТ) have no KZ chars but are exclusively\n    # used in Kazakh sessions. History walk can't help here because the\n    # clarification gate uses update_state_only (no history entry saved yet).\n    if message.strip().lower() in _KZ_ENTITY_EXACT:\n        return \"kz\"\n    # Short answers like \"да\", \"иә\" without KZ chars — inherit from history.\n    if history and len(message.strip()) <= 10:\n        for msg in reversed(history):\n            if msg[\"role\"] == \"user\" and len(msg[\"content\"]) > 3:\n                return \"kz\" if any(ch in _KZ_CHARS for ch in msg[\"content\"]) else \"ru\"\n    return \"ru\"\n\n\ndef _detect_entity(message: str, history: list[dict]) -> Optional[str]:\n    stripped = message.strip().lower()\n    if stripped in _FL_EXACT:\n        return \"физическое лицо\"\n    if stripped in _UL_EXACT:\n        return \"юридическое лицо\"\n\n    # Scan current message + all prior user turns\n    all_text = \" \" + message.lower() + \" \"\n    for msg in history:\n        if msg[\"role\"] == \"user\":\n            all_text += \" \" + msg[\"content\"].lower() + \" \"\n\n    if any(ph in all_text for ph in _FL_PHRASES):\n        return \"физическое лицо\"\n    if any(ph in all_text for ph in _UL_PHRASES):\n        return \"юридическое лицо\"\n    return None\n\n\ndef _clarification_question(lang: str) -> str:\n    if lang == \"kz\":\n        return (\n            \"Нақты нұсқаулық беру үшін нақтылап кетіңізші: \"\n            \"сіз өтінішті жеке тұлға (ЖТ) әлде заңды тұлға (ЗТ) ретінде бересіз бе?\"\n        )\n    return (\n        \"Чтобы я дал точную инструкцию, подскажите: \"\n        \"вы подаете заявление как физическое (ФЛ) или юридическое лицо (ЮЛ)?\"\n    )\n\n\ndef _needs_entity_clarification(\n    intent: Optional[str], entity: Optional[str], page: Optional[str]\n) -> bool:\n    if entity is not None:\n        return False\n    # Only TU application branches on entity type (ФЛ/ЮЛ have different forms).\n    # Real estate object addition is identical for all user types.\n    if intent != \"tu_application\":\n        return False\n    # Shared steps (2–5) work the same for both entity types — skip gate\n    if page and any(step in page.lower() for step in _SHARED_STEPS):\n        return False\n    return True\n\n\ndef _build_history_text(history: list[dict]) -> str:\n    lines = []\n    for msg in history[-6:]:\n        role = \"Пользователь\" if msg[\"role\"] == \"user\" else \"Ассистент\"\n        lines.append(f\"{role}: {msg['content']}\")\n    return \"\\n\".join(lines)\n\n\ndef _annotate_question(message: str, entity: Optional[str], lang: str) -> str:\n    if not entity:\n        return message\n    ann = (\n        f\"[пайдаланушы көрсетті: {entity}]\" if lang == \"kz\"\n        else f\"[пользователь уже указал: {entity}]\"\n    )\n    return f\"{message} {ann}\"\n\n\n# ---------------------------------------------------------------------------\n# Main handler\n# ---------------------------------------------------------------------------\n\n@router.post(\"/chat\", response_model=ChatResponse)\nasync def chat(request: ChatRequest):\n    # --- Input validation ---\n    try:\n        request.message = validate_message(request.message)\n        request.session_id = validate_session_id(request.session_id)\n    except ValidationError as e:\n        return ChatResponse(\n            answer=f\"Неверный запрос: {str(e)}\", source=\"validation\", handoff=False\n        )\n\n    # --- Rate limiting ---\n    if not chat_limiter.is_allowed(request.session_id):\n        return ChatResponse(\n            answer=\"Слишком много запросов. Подождите несколько секунд.\",\n            source=\"rate_limit\",\n            handoff=False,\n        )\n\n    sessions.cleanup()\n\n    # --- Rule-based shortcut (greetings, identity, handoff) ---\n    rule_answer, _ = check_rule(request.message)\n    if rule_answer:\n        log_chat_request(request.session_id, request.message, \"rule_based\")\n        return ChatResponse(answer=rule_answer, source=\"rule_based\", handoff=False)\n\n    # --- Session load ---\n    history = sessions.get_history(request.session_id)\n    state = sessions.get_state(request.session_id)\n    request.message = normalize_kz(request.message)\n    lang = _detect_language(request.message, history)\n\n    # --- Intent classification ---\n    new_intent = classify_intent(request.message, request.page, state.intent)\n\n    # --- FAQ interruption: locked flow + no flow keywords + not a step phrase ---\n    # Answer the FAQ question without disturbing the active flow state.\n    active_flow = get_flow(state.intent)\n    is_faq_interruption = (\n        state.locked\n        and state.intent is not None\n        and not active_flow.is_step_progression(request.message)\n        and not has_flow_keywords(request.message)\n    )\n    if is_faq_interruption:\n        faq_ctx = FlowContext(\n            message=request.message,\n            language=lang,\n            history=history,\n            page=request.page,\n            state=state,\n        )\n        query = FAQFlow().build_query(faq_ctx)\n        context = await search_docs(query, intent=None, entity=None, language=lang)\n        answer = await ask_llm(\n            request.message,\n            context if context else \"Контекст недоступен.\",\n            language=lang,\n            history=_build_history_text(history),\n        )\n        sessions.update_history_only(request.session_id, request.message, answer)\n        log_chat_request(request.session_id, request.message, \"faq_interruption\")\n        return ChatResponse(answer=answer, source=\"llm\", handoff=False)\n\n    # --- Intent update (only when not locked, or explicit switch) ---\n    if new_intent != state.intent:\n        if not state.locked:\n            # Fresh intent — reset all flow state, capture original question\n            state = FlowState(intent=new_intent, original_question=request.message)\n        # If locked, explicit keyword switch is still allowed\n        elif new_intent is not None and new_intent != state.intent:\n            state = FlowState(intent=new_intent, original_question=request.message)\n\n    # --- Entity detection ---\n    if state.entity is None:\n        detected = _detect_entity(request.message, history)\n        if detected:\n            state = state.model_copy(update={\"entity\": detected})\n\n    # --- Entity clarification gate ---\n    if _needs_entity_clarification(state.intent, state.entity, request.page):\n        sessions.update_state_only(request.session_id, state)\n        return ChatResponse(\n            answer=_clarification_question(lang), source=\"rule_based\", handoff=False\n        )\n\n    # --- Flow state transition ---\n    flow = get_flow(state.intent)\n    ctx = FlowContext(\n        message=request.message,\n        language=lang,\n        history=history,\n        page=request.page,\n        state=state,\n    )\n    state = flow.next_state(ctx)\n\n    # Lock once a flow is underway — prevents accidental intent resets.\n    # TU: requires entity + step to be set (ФЛ/ЮЛ branches differ from step 1).\n    # Real estate: locks as soon as the situation is chosen (no entity gate).\n    _can_lock = (\n        (state.intent == \"tu_application\" and state.entity is not None and state.step is not None)\n        or (state.intent == \"real_estate\" and state.situation is not None)\n    )\n    if not state.locked and _can_lock:\n        state = state.model_copy(update={\"locked\": True})\n\n    # --- RAG retrieval ---\n    ctx = ctx.__class__(\n        message=request.message,\n        language=lang,\n        history=history,\n        page=request.page,\n        state=state,\n    )\n    query = flow.build_query(ctx)\n    context = await search_docs(\n        query,\n        intent=state.intent,\n        entity=state.entity,\n        language=lang,\n        current_step=state.step,\n    )\n\n    # --- LLM generation ---\n    answer = await ask_llm(\n        _annotate_question(request.message, state.entity, lang),\n        context if context else \"Контекст недоступен.\",\n        page=request.page,\n        language=lang,\n        history=_build_history_text(history),\n        intent=state.intent,\n        entity=state.entity,\n        current_step=state.step,\n    )\n\n    sessions.update(request.session_id, state, request.message, answer)\n    log_chat_request(request.session_id, request.message, \"llm\")\n    return ChatResponse(answer=answer, source=\"llm\", handoff=False)\n","structuredPatch":[{"oldStart":274,"oldLines":6,"newStart":274,"newLines":7,"lines":["         intent=state.intent,","         entity=state.entity,","         current_step=state.step,","+        situation=state.situation,","     )"," ","     sessions.update(request.session_id, state, request.message, answer)"]}],"userModified":false,"replaceAll":false},"tool_use_id":"toolu_01EFh57cyrTZywxZYiAgQELE","duration_ms":6}

