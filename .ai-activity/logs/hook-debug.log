yIntent::test_explicit_switch_re_to_tu PASSED [ 56%]\r\ntests/test_flows.py::TestClassifyIntent::test_page_based_tu_detection PASSED [ 57%]\r\ntests/test_flows.py::TestClassifyIntent::test_page_based_re_detection PASSED [ 59%]\r\ntests/test_flows.py::TestClassifyIntent::test_none_intent_no_page_no_keywords PASSED [ 61%]\r\ntests/test_flows.py::TestHasFlowKeywords::test_tu_keywords PASSED        [ 63%]\r\ntests/test_flows.py::TestHasFlowKeywords::test_re_keywords PASSED        [ 64%]\r\ntests/test_flows.py::TestHasFlowKeywords::test_no_keywords PASSED        [ 66%]\r\ntests/test_flows.py::TestGetFlow::test_tu_returns_linear PASSED          [ 68%]\r\ntests/test_flows.py::TestGetFlow::test_re_returns_scenario PASSED        [ 70%]\r\ntests/test_flows.py::TestGetFlow::test_none_returns_faq PASSED           [ 71%]\r\ntests/test_flows.py::TestGetFlow::test_unknown_intent_returns_faq PASSED [ 73%]\r\ntests/test_flows.py::TestInvalidTransitions::test_no_step_without_entity_even_after_progression PASSED [ 75%]\r\ntests/test_flows.py::TestInvalidTransitions::test_step_doesnt_regress PASSED [ 77%]\r\ntests/test_session.py::test_empty_session_returns_default_state PASSED   [ 78%]\r\ntests/test_session.py::test_empty_session_returns_empty_history PASSED   [ 80%]\r\ntests/test_session.py::test_update_persists_state PASSED                 [ 82%]\r\ntests/test_session.py::test_update_appends_history PASSED                [ 84%]\r\ntests/test_session.py::test_history_capped_at_20_entries PASSED          [ 85%]\r\ntests/test_session.py::test_get_history_returns_copy PASSED              [ 87%]\r\ntests/test_session.py::test_update_history_only_preserves_state PASSED   [ 89%]\r\ntests/test_session.py::test_update_history_only_records_exchange PASSED  [ 91%]\r\ntests/test_session.py::test_update_state_only_doesnt_add_history PASSED  [ 92%]\r\ntests/test_session.py::test_update_state_only_persists_state PASSED      [ 94%]\r\ntests/test_session.py::test_sessions_are_isolated PASSED                 [ 96%]\r\ntests/test_session.py::test_cleanup_removes_expired_sessions PASSED      [ 98%]\r\ntests/test_session.py::test_cleanup_preserves_active_sessions PASSED     [100%]\r\n\r\n============================= 57 passed in 0.21s ==============================","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_use_id":"toolu_01Q6KtfHvZ1gFTKS771uJ1Pz","duration_ms":1015}

