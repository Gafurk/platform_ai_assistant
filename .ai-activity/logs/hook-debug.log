ру\":               \"өшіру\",\n    \"жангарту\":            \"жаңарту\",\n    \"озгерту\":             \"өзгерту\",\n    \"озгертилди\":          \"өзгертілді\",\n    \"кате\":                \"қате\",\n    \"дурыс\":               \"дұрыс\",\n    \"тиркелу\":             \"тіркелу\",\n    \"киру\":                \"кіру\",\n    \"шыгу\":                \"шығу\",\n    \"кужаттар\":            \"құжаттар\",\n    \"кужат\":               \"құжат\",\n    \"жагдайлар\":           \"жағдайлар\",\n    \"жагдай\":              \"жағдай\",\n    \"болімге\":             \"бөлімге\",\n    \"болім\":               \"бөлім\",\n    \"паракшага\":           \"парақшаға\",\n    \"паракша\":             \"парақша\",\n    \"издеу\":               \"іздеу\",\n    \"сузги\":               \"сүзгі\",\n    \"жок\":                 \"жоқ\",\n    \"ия\":                  \"иә\",\n}\n\n\ndef normalize_kz(message: str) -> str:\n    \"\"\"Return message with transliterated Kazakh replaced by proper Kazakh Cyrillic.\n\n    No-op when the message already contains Kazakh-specific characters.\n    \"\"\"\n    if any(ch in _KZ_CHARS for ch in message):\n        return message\n    result = message.lower()\n    for src, dst in sorted(_TRANSLIT_MAP.items(), key=lambda x: -len(x[0])):\n        result = result.replace(src, dst)\n    return result\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_use_id":"toolu_015ptYsrQsxzMw7kJi61hEqT","duration_ms":17}

