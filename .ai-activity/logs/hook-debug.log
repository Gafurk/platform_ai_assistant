itle']} ({entity_tag})\",\n                \"text\": f\"{chunk['title']}\\n\\n{marker}\\n\\n{content}\",\n            })\n        i += 2\n\n    return result if result else [chunk]\n\n\nasync def ingest_file(filepath: str, filename: str):\n    \"\"\"Process a document and insert structured blocks into LightRAG.\"\"\"\n    print(f\"\\n📄 Processing: {filename}\")\n\n    ext = filename.lower().split(\".\")[-1]\n    if ext == \"pdf\":\n        text = parse_pdf(filepath)\n    elif ext == \"docx\":\n        text = parse_docx(filepath)\n    elif ext in [\"txt\", \"md\"]:\n        with open(filepath, \"r\", encoding=\"utf-8\") as f:\n            text = f.read()\n    else:\n        print(f\"⚠️  Unsupported format .{ext}, skipping.\")\n        return\n\n    if not text.strip():\n        print(f\"⚠️  Empty file, skipping.\")\n        return\n\n    intent_name_raw = _extract_intent_name(text)\n    intent_slug, intent_name = _slug_intent(intent_name_raw, filename)","numLines":65,"startLine":225,"totalLines":352}},"tool_use_id":"toolu_019Tg3dsq7SpxNfYUPtNkHGu","duration_ms":2}

