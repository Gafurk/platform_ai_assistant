):\n    \"\"\"Run ingestion for a single file.\"\"\"\n    log_ingestion_start(filename)\n    try:\n        from ingestion.ingest import ingest_file\n        result = await ingest_file(filepath, filename)\n        chunks_count = result.get(\"chunks_count\", 0) if isinstance(result, dict) else 0\n        log_ingestion_complete(filename, chunks_count, \"success\")\n        print(f\"✅ Ingestion complete for: {filename}\")\n    except Exception as e:\n        log_ingestion_error(filename, str(e))\n        print(f\"❌ Ingestion failed for {filename}: {str(e)}\")","originalFile":"import os\nimport shutil\nimport uuid\nimport asyncio\nfrom fastapi import APIRouter, UploadFile, File, HTTPException\nfrom fastapi.responses import JSONResponse\nfrom app.services.task_queue import ingestion_queue\nfrom app.utils.logger import log_document_upload, log_ingestion_start, log_ingestion_complete, log_ingestion_error\n\nrouter = APIRouter()\n\nDOCS_DIR = \"data/docs\"\nSUPPORTED_EXTENSIONS = {\".pdf\", \".txt\", \".md\", \".docx\"}\n\n\n@router.post(\"/upload\")\nasync def upload_document(file: UploadFile = File(...)):\n    \"\"\"Upload a document and trigger ingestion into Qdrant.\"\"\"\n\n    ext = os.path.splitext(file.filename)[1].lower()\n    if ext not in SUPPORTED_EXTENSIONS:\n        raise HTTPException(\n            status_code=400,\n            detail=f\"Unsupported file type: {ext}. Allowed: {', '.join(SUPPORTED_EXTENSIONS)}\"\n        )\n\n    os.makedirs(DOCS_DIR, exist_ok=True)\n    safe_filename = f\"{uuid.uuid4().hex}_{file.filename}\"\n    file_path = os.path.join(DOCS_DIR, safe_filename)\n\n    try:\n        with open(file_path, \"wb\") as f:\n            shutil.copyfileobj(file.file, f)\n\n        file_size_kb = os.path.getsize(file_path) / 1024\n        log_document_upload(safe_filename, round(file_size_kb, 1), \"uploaded\")\n\n        # Queue ingestion with concurrency limit\n        await ingestion_queue.submit(_run_ingestion(file_path, safe_filename))\n\n        queue_status = await ingestion_queue.get_status()\n        return JSONResponse(content={\n            \"status\": \"queued\",\n            \"filename\": safe_filename,\n            \"message\": f\"File queued for ingestion. Active: {queue_status['active_tasks']}, Queued: {queue_status['queued_tasks']}\"\n        })\n    except Exception as e:\n        log_document_upload(safe_filename, 0, f\"failed: {str(e)}\")\n        if os.path.exists(file_path):\n            os.remove(file_path)\n        raise HTTPException(status_code=500, detail=f\"Upload failed: {str(e)}\")\n\n\n@router.get(\"/documents\")\nasync def list_documents():\n    \"\"\"Return list of all uploaded documents.\"\"\"\n    os.makedirs(DOCS_DIR, exist_ok=True)\n    files = []\n\n    for filename in os.listdir(DOCS_DIR):\n        ext = os.path.splitext(filename)[1].lower()\n        if ext in SUPPORTED_EXTENSIONS:\n            filepath = os.path.join(DOCS_DIR, filename)\n            files.append({\n                \"filename\": filename,\n                \"size_kb\": round(os.path.getsize(filepath) / 1024, 1),\n                \"extension\": ext\n            })\n\n    return {\"documents\": files, \"total\": len(files)}\n\n\n@router.delete(\"/documents/{filename}\")\nasync def delete_document(filename: str):\n    \"\"\"Delete a document from disk.\"\"\"\n    filepath = os.path.join(DOCS_DIR, filename)\n\n    if not os.path.exists(filepath):\n        raise HTTPException(status_code=404, detail=\"File not found\")\n\n    os.remove(filepath)\n    return {\"status\": \"deleted\", \"filename\": filename}\n\n\nasync def _run_ingestion(filepath: str, filename: str):\n    \"\"\"Run ingestion for a single file.\"\"\"\n    try:\n        from ingestion.ingest import ingest_file\n        await ingest_file(filepath, filename)\n        print(f\" Ingestion complete for: {filename}\")\n    except Exception as e:\n        print(f\" Ingestion failed for {filename}: {str(e)}\")","structuredPatch":[{"oldStart":84,"oldLines":9,"newStart":84,"newLines":13,"lines":[" "," async def _run_ingestion(filepath: str, filename: str):","     \"\"\"Run ingestion for a single file.\"\"\"","+    log_ingestion_start(filename)","     try:","         from ingestion.ingest import ingest_file","-        await ingest_file(filepath, filename)","-        print(f\" Ingestion complete for: {filename}\")","+        result = await ingest_file(filepath, filename)","+        chunks_count = result.get(\"chunks_count\", 0) if isinstance(result, dict) else 0","+        log_ingestion_complete(filename, chunks_count, \"success\")","+        print(f\"✅ Ingestion complete for: {filename}\")","     except Exception as e:","-        print(f\" Ingestion failed for {filename}: {str(e)}\")","\\ No newline at end of file","+        log_ingestion_error(filename, str(e))","+        print(f\"❌ Ingestion failed for {filename}: {str(e)}\")","\\ No newline at end of file"]}],"userModified":false,"replaceAll":false},"tool_use_id":"toolu_01JsNiAhRZPKzwm3f7d792Kb","duration_ms":5}

2026-05-05T08:48:10.515Z {"session_id":"ecbabb33-c3c8-42cb-9008-6feb0556cea4","transcript_path":"C:\\Users\\yasmi\\.claude\\projects\\e--workstuff-platform-ai-assistant\\ecbabb33-c3c8-42cb-9008-6feb0556cea4.jsonl","cwd":"e:\\workstuff\\platform_ai_assistant","permission_mode":"acceptEdits","hook_event_name":"Stop","stop_hook_active":false,"last_assistant_message":"**All 9 critical issues fixed!** ✅\n\n## Summary of Changes\n\n### 1. **Memory Leak** (chat.py)\n- Added `session_accessed` dict to track last access time\n- Sessions idle >24 hours are automatically cleaned up\n- Cleanup runs on every chat request\n\n### 2. **XSS Vulnerability** (frontend/index.html)\n- Changed delete button from inline string interpolation to `data-filename` attribute\n- Used `CSS.escape()` for safe filename handling\n\n### 3. **Language Lost at Query Time** (chat.py + rag.py)\n- Added `language` parameter to `search_docs()`\n- Now filters Qdrant by detected language + intent\n- Kazakh/Russian queries retrieve language-matched context\n\n### 4. **Hardcoded Localhost** (frontend/index.html)\n- API endpoint now uses `window.location.origin` dynamically\n- Works on any domain, fallback to localhost for file:// access\n\n### 5. **Qdrant Retry Logic** (rag.py)\n- Added `_retry_with_backoff()` with exponential backoff (1s → 2s → 4s)\n- Retries up to 3 times on timeout/connection errors\n- Better error logging on final failure\n\n### 6. **Input Validation** (validation.py + chat.py)\n- Created new `validation.py` module with sanitization\n- Messages capped at 2000 chars\n- Session IDs validated (alphanumeric + dash/underscore only)\n- Null bytes removed to prevent injection\n- Invalid input returns clear error message\n\n### 7. **Rate Limiting** (rate_limit.py + chat.py)\n- Added token bucket rate limiter\n- 10 requests per 60 seconds per session\n- Prevents DoS attacks on the chat endpoint\n\n### 8. **Error Logging** (logger.py + all services)\n- New structured logging to `logs/` directory\n- Tracks:\n  - Chat requests (success/errors)\n  - RAG search operations (intent, language, results count)\n  - Qdrant errors\n  - Document uploads + ingestion\n- Both file and console logging (errors only to console)\n\n### 9. **Ingestion Race Condition** (task_queue.py + documents.py)\n- Created task queue with concurrency limit (max 2 concurrent ingestions)\n- Queue responses show active + queued task counts\n- Proper error handling with file cleanup on failure\n- Detailed logging of ingestion lifecycle\n\n---\n\n**New files created:**\n- `app/services/validation.py` — Input validation\n- `app/services/rate_limit.py` — DoS protection\n- `app/services/task_queue.py` — Ingestion queue management\n- `app/utils/logger.py` — Structured logging\n- `app/utils/__init__.py` — Module init\n\nReady to test? Start the server with `uvicorn app.main:app --reload --port 8001` and check `logs/` for activity."}

