2026-05-12T09:49:57.246Z {"session_id":"312b487d-4e39-42c1-9f7b-e79ad731811e","transcript_path":"C:\\Users\\yasmi\\.claude\\projects\\e--workstuff-platform-ai-assistant\\312b487d-4e39-42c1-9f7b-e79ad731811e.jsonl","cwd":"e:\\workstuff\\platform_ai_assistant","permission_mode":"acceptEdits","effort":{"level":"medium"},"hook_event_name":"PostToolUse","tool_name":"Edit","tool_input":{"file_path":"e:\\workstuff\\platform_ai_assistant\\frontend\\index.html","old_string":"          <button class=\"chip\" onclick=\"sendMessage('Нужен оператор')\">Позвать оператора</button>\n","new_string":"","replace_all":false},"tool_response":{"filePath":"e:\\workstuff\\platform_ai_assistant\\frontend\\index.html","oldString":"          <button class=\"chip\" onclick=\"sendMessage('Нужен оператор')\">Позвать оператора</button>\n","newString":"","originalFile":"<!DOCTYPE html>\n<html lang=\"ru\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <title>iSEL AI Assistant</title>\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\">\n  <link rel=\"stylesheet\" href=\"https://cdn-uicons.flaticon.com/2.1.0/uicons-regular-rounded/css/uicons-regular-rounded.css\">\n  <style>\n    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\n\n    body {\n      font-family: 'Inter', 'Segoe UI', system-ui, sans-serif;\n      background: #f0f4ff;\n      min-height: 100vh;\n      -webkit-font-smoothing: antialiased;\n      -moz-osx-font-smoothing: grayscale;\n    }\n\n    /* ── Page shell ─────────────────────────────────────────────────── */\n\n    .page-header {\n      padding: 18px 36px;\n      display: flex;\n      align-items: center;\n      gap: 12px;\n      background: white;\n      border-bottom: 1px solid rgba(0,0,0,0.06);\n    }\n\n    .header-logo {\n      width: 34px;\n      height: 34px;\n      background: linear-gradient(135deg, #1a56db, #3b82f6);\n      border-radius: 9px;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-size: 17px;\n      flex-shrink: 0;\n    }\n\n    .header-text h1 {\n      font-size: 16px;\n      font-weight: 600;\n      color: #0f172a;\n      letter-spacing: -0.3px;\n    }\n\n    .header-text p {\n      font-size: 12px;\n      color: #94a3b8;\n      font-weight: 400;\n      margin-top: 1px;\n    }\n\n    .page-body {\n      padding: 36px;\n      max-width: 520px;\n    }\n\n    /* ── Document card ───────────────────────────────────────────────── */\n\n    .doc-card {\n      background: white;\n      border-radius: 20px;\n      padding: 26px;\n      box-shadow: 0 1px 2px rgba(0,0,0,0.04), 0 8px 24px rgba(0,0,0,0.05);\n    }\n\n    .card-title {\n      font-size: 14px;\n      font-weight: 600;\n      color: #0f172a;\n      letter-spacing: -0.2px;\n      margin-bottom: 18px;\n      display: flex;\n      align-items: center;\n      gap: 9px;\n    }\n\n    .card-title-icon {\n      width: 30px;\n      height: 30px;\n      background: #eff6ff;\n      border-radius: 8px;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-size: 15px;\n    }\n\n    .upload-area {\n      border: 1.5px dashed #cbd5e1;\n      border-radius: 14px;\n      padding: 26px 20px;\n      text-align: center;\n      cursor: pointer;\n      transition: all 0.2s ease;\n      margin-bottom: 12px;\n      background: #fafbff;\n    }\n\n    .upload-area:hover {\n      border-color: #1a56db;\n      background: #f0f4ff;\n    }\n\n    .upload-icon-wrap {\n      width: 44px;\n      height: 44px;\n      background: #eff6ff;\n      border-radius: 12px;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      margin: 0 auto 10px;\n      font-size: 20px;\n    }\n\n    .upload-area p {\n      font-size: 13px;\n      color: #64748b;\n      line-height: 1.5;\n    }\n\n    .upload-area p strong { color: #1a56db; font-weight: 500; }\n\n    .selected-file-row {\n      display: none;\n      align-items: center;\n      gap: 8px;\n      font-size: 13px;\n      color: #374151;\n      padding: 8px 12px;\n      background: #f8fafc;\n      border-radius: 9px;\n      margin-bottom: 10px;\n    }\n\n    .upload-btn {\n      width: 100%;\n      padding: 11px 16px;\n      background: #1a56db;\n      color: white;\n      border: none;\n      border-radius: 11px;\n      font-size: 13.5px;\n      font-weight: 500;\n      cursor: pointer;\n      font-family: inherit;\n      letter-spacing: -0.1px;\n      transition: all 0.2s ease;\n    }\n\n    .upload-btn:hover:not(:disabled) {\n      background: #1648c0;\n      transform: translateY(-1px);\n      box-shadow: 0 4px 14px rgba(26,86,219,0.3);\n    }\n\n    .upload-btn:disabled { background: #e2e8f0; color: #94a3b8; cursor: not-allowed; }\n\n    .status-msg {\n      margin-top: 10px;\n      padding: 10px 14px;\n      border-radius: 10px;\n      font-size: 13px;\n      line-height: 1.45;\n      display: none;\n    }\n\n    .status-msg.success { background: #ecfdf5; color: #065f46; display: block; }\n    .status-msg.error   { background: #fef2f2; color: #991b1b; display: block; }\n    .status-msg.info    { background: #eff6ff; color: #1e40af; display: block; }\n\n    .doc-list-section { margin-top: 22px; }\n\n    .doc-list-label {\n      font-size: 11px;\n      color: #94a3b8;\n      text-transform: uppercase;\n      letter-spacing: 0.6px;\n      font-weight: 500;\n      margin-bottom: 10px;\n    }\n\n    .doc-item {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      padding: 9px 12px;\n      background: #f8fafc;\n      border-radius: 10px;\n      margin-bottom: 6px;\n      font-size: 13px;\n      transition: background 0.15s;\n    }\n\n    .doc-item:hover { background: #f1f5f9; }\n\n    .doc-name {\n      display: flex;\n      align-items: center;\n      gap: 7px;\n      color: #334155;\n      font-weight: 400;\n      min-width: 0;\n    }\n\n    .doc-name span { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n\n    .doc-meta { display: flex; align-items: center; gap: 7px; flex-shrink: 0; }\n\n    .doc-size { color: #94a3b8; font-size: 12px; }\n\n    .doc-badge {\n      padding: 2px 8px;\n      border-radius: 20px;\n      font-size: 11px;\n      font-weight: 500;\n      background: #ecfdf5;\n      color: #059669;\n    }\n\n    .delete-btn {\n      background: none;\n      border: none;\n      cursor: pointer;\n      padding: 3px 5px;\n      color: #cbd5e1;\n      font-size: 13px;\n      line-height: 1;\n      transition: color 0.15s;\n      border-radius: 5px;\n    }\n\n    .delete-btn:hover { color: #ef4444; }\n\n    /* ── FAB ────────────────────────────────────────────────────────── */\n\n    .fab-wrap {\n      position: fixed;\n      bottom: 28px;\n      right: 28px;\n      z-index: 1000;\n    }\n\n    .fab-pulse {\n      position: absolute;\n      inset: 0;\n      border-radius: 50%;\n      background: rgba(26,86,219,0.22);\n      animation: fabPulse 2.8s ease-out infinite;\n      pointer-events: none;\n    }\n\n    @keyframes fabPulse {\n      0%   { transform: scale(1);   opacity: 0.8; }\n      100% { transform: scale(1.9); opacity: 0; }\n    }\n\n    .fab {\n      position: relative;\n      width: 58px;\n      height: 58px;\n      border-radius: 50%;\n      background: #1a56db;\n      box-shadow: 0 6px 20px rgba(26,86,219,0.42);\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      cursor: pointer;\n      border: none;\n      transition: transform 0.28s cubic-bezier(0.34,1.56,0.64,1),\n                  box-shadow 0.28s ease;\n    }\n\n    .fab:hover {\n      transform: scale(1.1);\n      box-shadow: 0 10px 28px rgba(26,86,219,0.5);\n    }\n\n    .fab .icon-chat  { display: flex; }\n    .fab .icon-close { display: none; }\n    .fab.open .icon-chat  { display: none; }\n    .fab.open .icon-close { display: flex; }\n\n    /* ── Chat widget ────────────────────────────────────────────────── */\n\n    .chat-widget {\n      position: fixed;\n      bottom: 102px;\n      right: 28px;\n      width: 400px;\n      height: 600px;\n      z-index: 999;\n      border-radius: 26px;\n      display: flex;\n      flex-direction: column;\n      overflow: hidden;\n      background: rgba(255,255,255,0.76);\n      backdrop-filter: blur(22px) saturate(180%);\n      -webkit-backdrop-filter: blur(22px) saturate(180%);\n      box-shadow:\n        0 0 0 1px rgba(255,255,255,0.55) inset,\n        0 2px 4px rgba(0,0,0,0.04),\n        0 16px 48px rgba(0,0,0,0.13),\n        0 40px 80px rgba(0,0,0,0.08);\n      /* closed state */\n      opacity: 0;\n      transform: scale(0.88) translateY(16px);\n      transform-origin: bottom right;\n      pointer-events: none;\n      transition:\n        opacity 0.32s cubic-bezier(0.16,1,0.3,1),\n        transform 0.32s cubic-bezier(0.16,1,0.3,1);\n    }\n\n    .chat-widget.open {\n      opacity: 1;\n      transform: scale(1) translateY(0);\n      pointer-events: all;\n    }\n\n    /* Widget header */\n    .widget-header {\n      padding: 16px 18px 13px;\n      border-bottom: 1px solid rgba(0,0,0,0.055);\n      display: flex;\n      align-items: center;\n      gap: 11px;\n      flex-shrink: 0;\n    }\n\n    .w-avatar {\n      width: 38px;\n      height: 38px;\n      border-radius: 50%;\n      background: linear-gradient(135deg, #1a56db 0%, #60a5fa 100%);\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-size: 18px;\n      flex-shrink: 0;\n    }\n\n    .w-info h3 {\n      font-size: 14px;\n      font-weight: 600;\n      color: #0f172a;\n      letter-spacing: -0.2px;\n    }\n\n    .w-status {\n      display: flex;\n      align-items: center;\n      gap: 5px;\n      font-size: 11.5px;\n      color: #10b981;\n      margin-top: 1px;\n      font-weight: 500;\n    }\n\n    .status-dot {\n      width: 6px;\n      height: 6px;\n      border-radius: 50%;\n      background: #10b981;\n    }\n\n    /* Messages */\n    .chat-messages {\n      flex: 1;\n      overflow-y: auto;\n      padding: 14px 14px 6px;\n      display: flex;\n      flex-direction: column;\n      gap: 10px;\n      scroll-behavior: smooth;\n    }\n\n    .chat-messages::-webkit-scrollbar { width: 3px; }\n    .chat-messages::-webkit-scrollbar-thumb {\n      background: rgba(0,0,0,0.09);\n      border-radius: 4px;\n    }\n\n    .message {\n      display: flex;\n      gap: 8px;\n      animation: msgIn 0.26s cubic-bezier(0.16,1,0.3,1);\n    }\n\n    @keyframes msgIn {\n      from { opacity: 0; transform: translateY(10px); }\n      to   { opacity: 1; transform: translateY(0); }\n    }\n\n    .message.user { flex-direction: row-reverse; }\n\n    .msg-avatar {\n      width: 28px;\n      height: 28px;\n      border-radius: 50%;\n      background: #eff6ff;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-size: 14px;\n      flex-shrink: 0;\n      align-self: flex-end;\n    }\n\n    .bubble {\n      max-width: 80%;\n      padding: 10px 14px;\n      border-radius: 18px;\n      font-size: 13.5px;\n      line-height: 1.58;\n      white-space: pre-wrap;\n    }\n\n    .message.bot .bubble {\n      background: #f1f5f9;\n      color: #1e293b;\n      border-bottom-left-radius: 5px;\n    }\n\n    .message.user .bubble {\n      background: #1a56db;\n      color: white;\n      border-bottom-right-radius: 5px;\n    }\n\n    .message.bot.handoff .bubble {\n      background: #fffbeb;\n      color: #92400e;\n      border-left: 2px solid #f59e0b;\n      border-bottom-left-radius: 5px;\n    }\n\n    .source-tag {\n      font-size: 10.5px;\n      color: #94a3b8;\n      margin-top: 3px;\n      padding-left: 2px;\n    }\n\n    /* Chips */\n    .chips {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 6px;\n      margin-top: 8px;\n    }\n\n    .chip {\n      padding: 6px 13px;\n      background: rgba(26,86,219,0.07);\n      color: #1a56db;\n      border-radius: 20px;\n      font-size: 12.5px;\n      font-weight: 500;\n      cursor: pointer;\n      border: none;\n      font-family: inherit;\n      letter-spacing: -0.1px;\n      transition: all 0.18s ease;\n    }\n\n    .chip:hover {\n      background: #1a56db;\n      color: white;\n      transform: translateY(-1px);\n      box-shadow: 0 4px 12px rgba(26,86,219,0.28);\n    }\n\n    /* Typing indicator */\n    .typing-bubble {\n      display: flex;\n      gap: 5px;\n      align-items: center;\n      padding: 11px 14px;\n      background: #f1f5f9;\n      border-radius: 18px;\n      border-bottom-left-radius: 5px;\n      width: fit-content;\n    }\n\n    .typing-dot {\n      width: 7px;\n      height: 7px;\n      border-radius: 50%;\n      background: #94a3b8;\n      animation: typingPulse 1.4s ease-in-out infinite;\n    }\n\n    .typing-dot:nth-child(2) { animation-delay: 0.18s; }\n    .typing-dot:nth-child(3) { animation-delay: 0.36s; }\n\n    @keyframes typingPulse {\n      0%, 60%, 100% { transform: scale(1);   opacity: 0.45; }\n      30%           { transform: scale(1.35); opacity: 1; }\n    }\n\n    /* Input zone */\n    .input-zone {\n      display: flex;\n      align-items: center;\n      gap: 10px;\n      padding: 11px 14px 15px;\n      border-top: 1px solid rgba(0,0,0,0.055);\n      background: rgba(255,255,255,0.55);\n      backdrop-filter: blur(10px);\n      flex-shrink: 0;\n    }\n\n    .chat-input {\n      flex: 1;\n      background: none;\n      border: none;\n      outline: none;\n      font-size: 13.5px;\n      font-family: inherit;\n      color: #0f172a;\n      line-height: 1.4;\n      padding: 4px 0;\n    }\n\n    .chat-input::placeholder { color: #94a3b8; }\n\n    .send-btn {\n      width: 36px;\n      height: 36px;\n      border-radius: 50%;\n      background: #1a56db;\n      border: none;\n      cursor: pointer;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      flex-shrink: 0;\n      transition: all 0.2s ease;\n    }\n\n    .send-btn:hover:not(:disabled) {\n      background: #1648c0;\n      transform: scale(1.1);\n      box-shadow: 0 4px 12px rgba(26,86,219,0.38);\n    }\n\n    .send-btn:disabled { background: #e2e8f0; cursor: not-allowed; }\n\n    #file-input { display: none; }\n\n    /* ── Uicons sizing ──────────────────────────────────────────────── */\n    /* Dashboard */\n    .header-logo i    { font-size: 17px; color: white; }\n    .card-title-icon i { font-size: 15px; color: #1a56db; }\n    .upload-icon-wrap i { font-size: 26px; color: #1a56db; }\n    .doc-name i       { font-size: 14px; color: #94a3b8; flex-shrink: 0; }\n    .delete-btn i     { font-size: 13px; }\n    /* Widget */\n    .w-avatar         { font-size: 0; }\n    .w-avatar i       { font-size: 18px; color: white; }\n    .msg-avatar       { font-size: 0; }\n    .msg-avatar i     { font-size: 14px; color: #1a56db; }\n    .fab .icon-chat i { font-size: 22px; color: white; }\n    .fab .icon-close i { font-size: 18px; color: white; }\n    .send-btn i       { font-size: 15px; color: white; }\n  </style>\n</head>\n<body>\n\n<!-- Page header -->\n<header class=\"page-header\">\n  <div class=\"header-logo\"><i class=\"fi fi-rr-comment-alt\"></i></div>\n  <div class=\"header-text\">\n    <h1>iSEL AI Assistant</h1>\n    <p>Панель администратора — База знаний</p>\n  </div>\n</header>\n\n<!-- Document management panel -->\n<div class=\"page-body\">\n  <div class=\"doc-card\">\n    <div class=\"card-title\">\n      <div class=\"card-title-icon\"><i class=\"fi fi-rr-folder\"></i></div>\n      База знаний\n    </div>\n\n    <div class=\"upload-area\" onclick=\"document.getElementById('file-input').click()\">\n      <div class=\"upload-icon-wrap\"><i class=\"fi fi-rr-cloud-upload\"></i></div>\n      <p><strong>Нажмите для выбора файла</strong></p>\n      <p style=\"font-size:12px;margin-top:3px;\">PDF, TXT, MD, DOCX</p>\n    </div>\n\n    <input type=\"file\" id=\"file-input\" accept=\".pdf,.txt,.md,.docx\" onchange=\"handleFileSelect(this)\" />\n\n    <div class=\"selected-file-row\" id=\"selected-file\">\n      <i class=\"fi fi-rr-clip\" style=\"font-size:13px;color:#94a3b8;\"></i>\n      <span id=\"selected-name\"></span>\n    </div>\n\n    <button class=\"upload-btn\" id=\"upload-btn\" onclick=\"uploadFile()\" disabled>\n      Загрузить документ\n    </button>\n\n    <div id=\"upload-status\" class=\"status-msg\"></div>\n\n    <div class=\"doc-list-section\">\n      <div class=\"doc-list-label\">Загруженные документы</div>\n      <div id=\"doc-list-container\">\n        <p style=\"font-size:13px;color:#94a3b8;\">Загрузка...</p>\n      </div>\n    </div>\n  </div>\n</div>\n\n<!-- FAB -->\n<div class=\"fab-wrap\">\n  <div class=\"fab-pulse\"></div>\n  <button class=\"fab\" id=\"fab\" onclick=\"toggleChat()\">\n    <span class=\"icon-chat\"><i class=\"fi fi-rr-comment-alt\"></i></span>\n    <span class=\"icon-close\"><i class=\"fi fi-rr-cross\"></i></span>\n  </button>\n</div>\n\n<!-- Chat widget -->\n<div class=\"chat-widget\" id=\"chat-widget\">\n\n  <div class=\"widget-header\">\n    <div class=\"w-avatar\"><i class=\"fi fi-rr-comment-alt\"></i></div>\n    <div class=\"w-info\">\n      <h3>iSEL AI Assistant</h3>\n      <div class=\"w-status\">\n        <div class=\"status-dot\"></div>\n        Онлайн\n      </div>\n    </div>\n  </div>\n\n  <div class=\"chat-messages\" id=\"chat-messages\">\n    <div class=\"message bot\">\n      <div class=\"msg-avatar\"><i class=\"fi fi-rr-comment-alt\"></i></div>\n      <div>\n        <div class=\"bubble\">Привет! Я ИИ-ассистент платформы iSEL. Чем могу помочь?</div>\n        <div class=\"chips\">\n          <button class=\"chip\" onclick=\"sendMessage('Как добавить объект недвижимости?')\">Добавить объект</button>\n          <button class=\"chip\" onclick=\"sendMessage('Как заполнить заявление на ТУ?')\">Заявление на ТУ</button>\n          <button class=\"chip\" onclick=\"sendMessage('Нужен оператор')\">Позвать оператора</button>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"input-zone\">\n    <input\n      class=\"chat-input\"\n      id=\"chat-input\"\n      type=\"text\"\n      placeholder=\"Напишите сообщение...\"\n      onkeydown=\"if(event.key==='Enter') sendMessage()\"\n    />\n    <button class=\"send-btn\" id=\"send-btn\" onclick=\"sendMessage()\">\n      <i class=\"fi fi-rr-paper-plane\"></i>\n    </button>\n  </div>\n\n</div>\n\n<script>\n  const API = (window.location.origin === 'file://' ? 'http://localhost:8001' : window.location.origin) + '/api/v1';\n  let sessionId = 'demo-' + Math.random().toString(36).substr(2, 9);\n  let selectedFile = null;\n  let chatOpen = false;\n\n  // ─── Widget ────────────────────────────────────────────────────────────────\n\n  function toggleChat() {\n    chatOpen = !chatOpen;\n    document.getElementById('fab').classList.toggle('open', chatOpen);\n    document.getElementById('chat-widget').classList.toggle('open', chatOpen);\n    if (chatOpen) document.getElementById('chat-input').focus();\n  }\n\n  // ─── Documents ────────────────────────────────────────────────────────────\n\n  function handleFileSelect(input) {\n    selectedFile = input.files[0];\n    if (!selectedFile) return;\n    document.getElementById('selected-name').textContent = selectedFile.name;\n    document.getElementById('selected-file').style.display = 'flex';\n    document.getElementById('upload-btn').disabled = false;\n  }\n\n  async function uploadFile() {\n    if (!selectedFile) return;\n    const btn = document.getElementById('upload-btn');\n    const status = document.getElementById('upload-status');\n\n    btn.disabled = true;\n    btn.textContent = 'Загружаю...';\n    status.className = 'status-msg info';\n    status.textContent = '⏳ Загрузка и обработка документа...';\n\n    const formData = new FormData();\n    formData.append('file', selectedFile);\n\n    try {\n      const res = await fetch(`${API}/upload`, { method: 'POST', body: formData });\n      const data = await res.json();\n      if (res.ok) {\n        status.className = 'status-msg success';\n        status.textContent = '✅ Документ загружен и обрабатывается в фоне';\n        selectedFile = null;\n        document.getElementById('selected-file').style.display = 'none';\n        document.getElementById('file-input').value = '';\n        setTimeout(loadDocuments, 25000);\n      } else {\n        status.className = 'status-msg error';\n        status.textContent = '❌ Ошибка: ' + (data.detail || 'Неизвестная ошибка');\n      }\n    } catch (e) {\n      status.className = 'status-msg error';\n      status.textContent = '❌ Сервер недоступен';\n    }\n\n    btn.textContent = 'Загрузить документ';\n    btn.disabled = false;\n  }\n\n  async function loadDocuments() {\n    try {\n      const res = await fetch(`${API}/documents`);\n      const data = await res.json();\n      const container = document.getElementById('doc-list-container');\n\n      if (data.documents.length === 0) {\n        container.innerHTML = '<p style=\"font-size:13px;color:#94a3b8;\">Нет загруженных документов</p>';\n        return;\n      }\n\n      container.innerHTML = data.documents.map(doc => `\n        <div class=\"doc-item\" id=\"doc-${CSS.escape(doc.filename)}\">\n          <div class=\"doc-name\">\n            <i class=\"fi fi-rr-document\"></i>\n            <span>${doc.filename.substring(0, 34)}${doc.filename.length > 34 ? '…' : ''}</span>\n          </div>\n          <div class=\"doc-meta\">\n            <span class=\"doc-size\">${doc.size_kb} KB</span>\n            <span class=\"doc-badge\">готов</span>\n            <button class=\"delete-btn\" data-filename=\"${CSS.escape(doc.filename)}\" onclick=\"deleteDocument(this.getAttribute('data-filename'))\" title=\"Удалить\">\n              <i class=\"fi fi-rr-trash\"></i>\n            </button>\n          </div>\n        </div>\n      `).join('');\n    } catch (e) {\n      document.getElementById('doc-list-container').innerHTML =\n        '<p style=\"font-size:13px;color:#ef4444;\">Ошибка загрузки списка</p>';\n    }\n  }\n\n  async function deleteDocument(filename) {\n    if (!confirm(`Удалить документ?\\n${filename}`)) return;\n    try {\n      const res = await fetch(`${API}/documents/${encodeURIComponent(filename)}`, { method: 'DELETE' });\n      if (res.ok) {\n        const item = document.getElementById(`doc-${CSS.escape(filename)}`);\n        if (item) {\n          item.style.transition = 'opacity 0.22s';\n          item.style.opacity = '0';\n          setTimeout(() => item.remove(), 220);\n        }\n      } else {\n        const data = await res.json();\n        alert('Ошибка: ' + (data.detail || 'Неизвестная ошибка'));\n      }\n    } catch (e) { alert('Сервер недоступен'); }\n  }\n\n  // ─── Chat ─────────────────────────────────────────────────────────────────\n\n  function renderMarkdown(text) {\n    return text\n      .replace(/\\*\\*(.*?)\\*\\*/g, '<strong>$1</strong>')\n      .replace(/^### (.+)$/gm, '<div style=\"font-weight:600;margin:6px 0 3px;font-size:13.5px;\">$1</div>')\n      .replace(/^## (.+)$/gm,  '<div style=\"font-weight:700;margin:8px 0 4px;font-size:14px;\">$1</div>')\n      .replace(/^\\d+\\.\\s(.+)$/gm, '<div style=\"margin:3px 0;\">$&</div>')\n      .replace(/^[•\\-]\\s(.+)$/gm, '<div style=\"margin:2px 0;padding-left:6px;\">• $1</div>')\n      .replace(/\\n/g, '<br>');\n  }\n\n  function addMessage(text, role, source = '', handoff = false) {\n    const container = document.getElementById('chat-messages');\n    const div = document.createElement('div');\n    div.className = `message ${role}${handoff ? ' handoff' : ''}`;\n    const sourceTag = '';\n\n    if (role === 'bot') {\n      div.innerHTML = `\n        <div class=\"msg-avatar\"><i class=\"fi fi-rr-comment-alt\"></i></div>\n        <div>\n          <div class=\"bubble\">${renderMarkdown(text)}</div>\n          ${sourceTag}\n        </div>`;\n    } else {\n      div.innerHTML = `<div class=\"bubble\">${renderMarkdown(text)}</div>`;\n    }\n\n    container.appendChild(div);\n    container.scrollTop = container.scrollHeight;\n  }\n\n  function addTyping() {\n    const container = document.getElementById('chat-messages');\n    const div = document.createElement('div');\n    div.className = 'message bot';\n    div.id = 'typing-indicator';\n    div.innerHTML = `\n      <div class=\"msg-avatar\"><i class=\"fi fi-rr-comment-alt\"></i></div>\n      <div class=\"typing-bubble\">\n        <div class=\"typing-dot\"></div>\n        <div class=\"typing-dot\"></div>\n        <div class=\"typing-dot\"></div>\n      </div>`;\n    container.appendChild(div);\n    container.scrollTop = container.scrollHeight;\n  }\n\n  function removeTyping() {\n    const el = document.getElementById('typing-indicator');\n    if (el) el.remove();\n  }\n\n  async function sendMessage(text) {\n    const input = document.getElementById('chat-input');\n    const sendBtn = document.getElementById('send-btn');\n    const message = text || input.value.trim();\n    if (!message) return;\n\n    input.value = '';\n    sendBtn.disabled = true;\n    addMessage(message, 'user');\n    addTyping();\n\n    try {\n      const res = await fetch(`${API}/chat`, {\n        method: 'POST',\n        headers: { 'Content-Type': 'application/json' },\n        body: JSON.stringify({\n          message,\n          session_id: sessionId,\n          page: '/demo',\n          language: 'ru'\n        })\n      });\n      const data = await res.json();\n      removeTyping();\n      addMessage(data.answer, 'bot', data.source, data.handoff);\n    } catch (e) {\n      removeTyping();\n      addMessage('❌ Сервер недоступен. Проверьте подключение.', 'bot');\n    }\n\n    sendBtn.disabled = false;\n    input.focus();\n  }\n\n  // ─── Init ──────────────────────────────────────────────────────────────────\n  loadDocuments();\n  setInterval(loadDocuments, 10000);\n</script>\n</body>\n</html>","structuredPatch":[{"oldStart":649,"oldLines":7,"newStart":649,"newLines":6,"lines":["         <div class=\"chips\">","           <button class=\"chip\" onclick=\"sendMessage('Как добавить объект недвижимости?')\">Добавить объект</button>","           <button class=\"chip\" onclick=\"sendMessage('Как заполнить заявление на ТУ?')\">Заявление на ТУ</button>","-          <button class=\"chip\" onclick=\"sendMessage('Нужен оператор')\">Позвать оператора</button>","         </div>","       </div>","     </div>"]}],"userModified":false,"replaceAll":false},"tool_use_id":"toolu_017k938dLsyKGAe8hbiMzZyK","duration_ms":8}

