еское лицо\"\n        page: Page context (optional)\n        language: \"ru\" or \"kz\"\n        current_step: Current step number for multi-step processes\n\n    Returns:\n        Context string formatted for the LLM\n    \"\"\"\n    return await lightrag_service.search_docs(\n        query=query,\n        top_k=top_k,\n        intent=intent,\n        entity=entity,\n        page=page,\n        language=language,\n        current_step=current_step,\n    )","replace_all":false},"tool_use_id":"toolu_01DxWFgTmWYaYLBDiBujpLA9"}

