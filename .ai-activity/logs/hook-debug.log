     status.className = 'status-msg error';\n754:      status.textContent = '❌ Сервер недоступен';\n755-    }\n756-\n757-    btn.textContent = 'Загрузить документ';\n758-    btn.disabled = false;\n759-  }\n760-\n761:  async function reindex() {\n762:    const btn = document.getElementById('reindex-btn');\n763:    const status = document.getElementById('reindex-status');\n764-\n765-    btn.disabled = true;\n766-    btn.textContent = '↺ Индексирую...';\n767:    status.className = 'status-msg info';\n768:    status.style.display = 'block';\n769:    status.textContent = '⏳ Подготовка...';\n770-\n771-    try {\n772:      const res = await fetch(`${API}/reindex`, { method: 'POST' });\n773-      if (!res.ok || !res.body) {\n774:        status.className = 'status-msg error';\n775:        status.textContent = '❌ Ошибка запуска переиндексации';\n776-        return;\n777-      }\n778-\n--\n781-      let buf = '';\n782-\n783-      while (true) {\n784:        const { done, value } = await reader.read();\n785:        if (done) break;\n786-        buf += decoder.decode(value, { stream: true });\n787-        const lines = buf.split('\\n');\n788-        buf = lines.pop();\n789-        for (const line of lines) {\n790-          if (!line.startsWith('data: ')) continue;\n791:          try { handleReindexEvent(JSON.parse(line.slice(6)), status); } catch {}\n792-        }\n793-      }\n794-    } catch (e) {\n795:      status.className = 'status-msg error';\n796:      status.textContent = '❌ Соединение прервано';\n797-    } finally {\n798-      btn.disabled = false;\n799-      btn.textContent = '↺ Переиндексировать граф знаний';\n800-    }\n801-  }\n802-\n803:  function handleReindexEvent(ev, status) {\n804:    if (ev.status === 'wiping') {\n805:      status.textContent = '🗑 Очистка старого графа...';\n806:    } else if (ev.status === 'init') {\n807:      status.textContent = '⚡ Инициализация LightRAG...';\n808:    } else if (ev.status === 'progress') {\n809-      const name = ev.file.length > 33 ? ev.file.substring(33) : ev.file;\n810:      status.textContent = `📄 (${ev.done + 1}/${ev.total}) ${name}`;\n811:    } else if (ev.status === 'file_error') {\n812:      status.className = 'status-msg error';\n813-      const name = ev.file.length > 33 ? ev.file.substring(33) : ev.file;\n814:      status.textContent = `⚠️ Ошибка: ${name} — ${ev.error}`;\n815:    } else if (ev.status === 'error') {\n816:      status.className = 'status-msg error';\n817:      status.textContent = `❌ ${ev.message}`;\n818:    } else if (ev.status === 'done') {\n819:      status.className = 'status-msg success';\n820:      status.textContent = ev.total === 0\n821-        ? '✅ Граф очищен — загрузите документы и переиндексируйте'\n822-        : `✅ Граф обновлён — ${ev.total} документов проиндексировано`;\n823-      loadDocuments();","numLines":168},"tool_use_id":"toolu_01NLgrbNszYntaAKo2YDxPGK","duration_ms":223}

2026-05-26T10:31:05.868Z {"session_id":"8e6f4227-1c72-4eb5-85c7-a4a0703b9a66","transcript_path":"C:\\Users\\yasmi\\.claude\\projects\\e--workstuff-platform-ai-assistant-worktrees-agents-architectural-review-project-files\\8e6f4227-1c72-4eb5-85c7-a4a0703b9a66.jsonl","cwd":"e:\\workstuff\\platform_ai_assistant.worktrees\\agents-architectural-review-project-files","permission_mode":"default","effort":{"level":"high"},"hook_event_name":"Stop","stop_hook_active":false,"last_assistant_message":"Всё понятно. Вот почему расхождение:\n\n**UI** получает SSE `{\"status\": \"done\", \"total\": N}` и показывает:\n```\n✅ Граф обновлён — N документов проиндексировано\n```\n\n**Терминал** молчит по двум причинам:\n\n**Причина 1 — console handler настроен на `ERROR` уровень** ([logger.py:33](app/utils/logger.py#L33)):\n```python\nconsole_handler.setLevel(logging.ERROR)  # INFO сообщения в терминал не идут\n```\nВсе `INGEST_START` и `INGEST_DONE` записи уходят только в файл `logs/app_TIMESTAMP.log`, в терминале видны только ошибки.\n\n**Причина 2 — нет лога завершения всей реиндексации** ([documents.py:133](app/routers/documents.py#L133)):\n```python\nyield evt({\"status\": \"done\", \"total\": total})\n# ← здесь нет logger.info(\"REINDEX_DONE | ...\")\n```\n\nЕсли хочешь видеть в терминале и прогресс и финальный результат, два варианта:\n\n**Вариант А — понизить уровень консоли до INFO** в [logger.py:33](app/utils/logger.py#L33):\n```python\nconsole_handler.setLevel(logging.INFO)\n```\nТогда в терминале будет всё: INGEST_START, INGEST_DONE, CHAT, RAG_SEARCH — может быть шумно.\n\n**Вариант Б — добавить только финальный лог** в [documents.py:133](app/routers/documents.py#L133) и вынести его на уровень WARNING (он идёт в консоль):\n```python\nyield evt({\"status\": \"done\", \"total\": total})\nlogger.warning(f\"REINDEX_DONE | total={total} docs indexed\")\n```\n\nКакой из вариантов нужен?","background_tasks":[],"session_crons":[]}

