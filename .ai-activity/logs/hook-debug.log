return None\n91-\n--\n99-    return (\n100-        \"Чтобы я дал точную инструкцию, подскажите: \"\n101:        \"вы подаете заявление как физическое (ФЛ) или юридическое лицо (ЮЛ)?\"\n102-    )\n103-\n--\n216-    # --- Entity detection ---\n217-    if state.entity is None:\n218:        detected = _detect_entity(request.message, history)\n219-        if detected:\n220-            state = state.model_copy(update={\"entity\": detected})","numLines":51},"tool_use_id":"toolu_01H77gURk815pTUyEwfENjwn","duration_ms":82}

