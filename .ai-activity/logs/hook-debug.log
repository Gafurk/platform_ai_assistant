 unsealing service\n    if \"пломб\" in combined:\n        return \"meter_sealing\", \"Установка/снятие пломбы\"\n    return \"general\", re.sub(r'\\.[^.]+$', '', filename)","replace_all":false},"tool_use_id":"toolu_01TtZqzjsQ37rBBPk4PuSoX6"}

