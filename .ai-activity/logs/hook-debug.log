уге\",\n})","replace_all":false},"tool_response":{"filePath":"e:\\workstuff\\platform_ai_assistant\\app\\flows\\scenario.py","oldString":"# Keywords used to detect which situation branch the user chose.\n# Checked against the user's message after translit normalization.\n# Situation 1 = cadastral number path; situation 2 = address register path.\n_SITUATION_KEYWORDS: dict[int, list[str]] = {\n    1: [\"кадастр\"],                                        # matches \"кадастр\", \"кадастровый\", \"кадастр арқылы\"…\n    2: [\"адресный регистр\", \"адрестік регистр\",\n        \"через адрес\", \"адрес арқылы\", \"адресный\"],       # specific enough to avoid false positives\n}","newString":"# Keywords that indicate the user is explicitly choosing a situation path,\n# not asking a question about cadastral numbers.\n# Situation 1 = cadastral number path; situation 2 = address register path.\n_SITUATION_KEYWORDS: dict[int, list[str]] = {\n    1: [\"кадастр арқылы\", \"кадастр аркылы\", \"через кадастр\",\n        \"по кадастру\", \"кадастрмен\", \"кадастровым номером\"],\n    2: [\"адресный регистр\", \"адрестік регистр\",\n        \"через адрес\", \"адрес арқылы\", \"адрес аркылы\",\n        \"мекенжай арқылы\", \"мекенжай аркылы\", \"адресный\"],\n}\n\n# Question words that indicate the user is asking about something,\n# not making a situation choice — skip situation detection for these.\n_QUESTION_WORDS = frozenset({\n    \"как\", \"где\", \"откуда\", \"что такое\",\n    \"қалай\", \"калай\", \"қайда\", \"кайда\", \"қайдан\", \"кайдан\",\n    \"как получить\", \"как узнать\", \"как найти\",\n    \"қалай алуға\", \"калай алуга\", \"қалай білуге\",\n})","originalFile":"from __future__ import annotations\n\nfrom app.flows.base import BaseFlow, FlowContext\nfrom app.models.schemas import FlowState\n\n# Keywords used to detect which situation branch the user chose.\n# Checked against the user's message after translit normalization.\n# Situation 1 = cadastral number path; situation 2 = address register path.\n_SITUATION_KEYWORDS: dict[int, list[str]] = {\n    1: [\"кадастр\"],                                        # matches \"кадастр\", \"кадастровый\", \"кадастр арқылы\"…\n    2: [\"адресный регистр\", \"адрестік регистр\",\n        \"через адрес\", \"адрес арқылы\", \"адресный\"],       # specific enough to avoid false positives\n}\n\n\nclass ScenarioFlow(BaseFlow):\n    \"\"\"Branching scenario flow (e.g. Real Estate — multiple situations).\"\"\"\n\n    flow_type = \"scenario\"\n    requires_entity = False  # Real estate process is identical for ФЛ/ЮЛ\n\n    def next_state(self, ctx: FlowContext) -> FlowState:\n        # Once situation is chosen, preserve it — never overwrite.\n        if ctx.state.situation is not None:\n            return ctx.state.model_copy()\n\n        msg_lower = ctx.message.lower()\n        for sit_num, keywords in _SITUATION_KEYWORDS.items():\n            if any(kw in msg_lower for kw in keywords):\n                # Append the clarification answer to original_question so\n                # build_query includes the situation keyword for RAG retrieval.\n                oq = f\"{ctx.state.original_question or ''} {ctx.message}\".strip()\n                return ctx.state.model_copy(update={\n                    \"situation\": sit_num,\n                    \"original_question\": oq,\n                })\n\n        return ctx.state.model_copy()\n\n    def build_query(self, ctx: FlowContext) -> str:\n        entity = ctx.state.entity or \"\"\n        # Use the saved original question as the semantic anchor for RAG retrieval.\n        # After situation is detected, original_question includes the user's\n        # situational answer (e.g. \"кадастр\"), so RAG finds the right chunks.\n        base = ctx.state.original_question or ctx.message\n        return f\"{entity} {base}\".strip()\n","structuredPatch":[{"oldStart":3,"oldLines":16,"newStart":3,"newLines":27,"lines":[" from app.flows.base import BaseFlow, FlowContext"," from app.models.schemas import FlowState"," ","-# Keywords used to detect which situation branch the user chose.","-# Checked against the user's message after translit normalization.","+# Keywords that indicate the user is explicitly choosing a situation path,","+# not asking a question about cadastral numbers."," # Situation 1 = cadastral number path; situation 2 = address register path."," _SITUATION_KEYWORDS: dict[int, list[str]] = {","-    1: [\"кадастр\"],                                        # matches \"кадастр\", \"кадастровый\", \"кадастр арқылы\"…","+    1: [\"кадастр арқылы\", \"кадастр аркылы\", \"через кадастр\",","+        \"по кадастру\", \"кадастрмен\", \"кадастровым номером\"],","     2: [\"адресный регистр\", \"адрестік регистр\",","-        \"через адрес\", \"адрес арқылы\", \"адресный\"],       # specific enough to avoid false positives","+        \"через адрес\", \"адрес арқылы\", \"адрес аркылы\",","+        \"мекенжай арқылы\", \"мекенжай аркылы\", \"адресный\"],"," }"," ","+# Question words that indicate the user is asking about something,","+# not making a situation choice — skip situation detection for these.","+_QUESTION_WORDS = frozenset({","+    \"как\", \"где\", \"откуда\", \"что такое\",","+    \"қалай\", \"калай\", \"қайда\", \"кайда\", \"қайдан\", \"кайдан\",","+    \"как получить\", \"как узнать\", \"как найти\",","+    \"қалай алуға\", \"калай алуга\", \"қалай білуге\",","+})"," ","+"," class ScenarioFlow(BaseFlow):","     \"\"\"Branching scenario flow (e.g. Real Estate — multiple situations).\"\"\""," "]}],"userModified":false,"replaceAll":false},"tool_use_id":"toolu_01Jkku8eE3nVyaMijidy79mR","duration_ms":7}

