tion=\"объект косу\")\n        new = self.flow.next_state(ctx(\"адресный регистр\", state=state))\n        assert new.situation == \"через адресный регистр\"\n\n    def test_situation_answer_appended_to_original_question(self):\n        state = FlowState(intent=\"real_estate\", original_question=\"объект косу\")\n        new = self.flow.next_state(ctx(\"кадастр арқылы\", state=state))\n        assert \"объект косу\" in new.original_question\n        assert \"кадастр арқылы\" in new.original_question\n\n    def test_situation_not_overwritten_once_set(self):\n        state = FlowState(intent=\"real_estate\", situation=\"через кадастровый номер\")\n        new = self.flow.next_state(ctx(\"адресный регистр\", state=state))\n        assert new.situation == \"через кадастровый номер\"  # must not switch","replace_all":false},"tool_response":{"filePath":"e:\\workstuff\\platform_ai_assistant\\tests\\test_flows.py","oldString":"    def test_cadastre_keyword_sets_situation_1(self):\n        state = FlowState(intent=\"real_estate\", original_question=\"объект косу\")\n        new = self.flow.next_state(ctx(\"кадастр арқылы\", state=state))\n        assert new.situation == 1\n\n    def test_address_keyword_sets_situation_2(self):\n        state = FlowState(intent=\"real_estate\", original_question=\"объект косу\")\n        new = self.flow.next_state(ctx(\"адресный регистр\", state=state))\n        assert new.situation == 2\n\n    def test_situation_answer_appended_to_original_question(self):\n        state = FlowState(intent=\"real_estate\", original_question=\"объект косу\")\n        new = self.flow.next_state(ctx(\"кадастр арқылы\", state=state))\n        assert \"объект косу\" in new.original_question\n        assert \"кадастр арқылы\" in new.original_question\n\n    def test_situation_not_overwritten_once_set(self):\n        state = FlowState(intent=\"real_estate\", situation=1)\n        new = self.flow.next_state(ctx(\"адресный регистр\", state=state))\n        assert new.situation == 1  # must not switch to 2","newString":"    def test_cadastre_keyword_sets_situation_cadastre(self):\n        state = FlowState(intent=\"real_estate\", original_question=\"объект косу\")\n        new = self.flow.next_state(ctx(\"кадастр арқылы\", state=state))\n        assert new.situation == \"через кадастровый номер\"\n\n    def test_address_keyword_sets_situation_address(self):\n        state = FlowState(intent=\"real_estate\", original_question=\"объект косу\")\n        new = self.flow.next_state(ctx(\"адресный регистр\", state=state))\n        assert new.situation == \"через адресный регистр\"\n\n    def test_situation_answer_appended_to_original_question(self):\n        state = FlowState(intent=\"real_estate\", original_question=\"объект косу\")\n        new = self.flow.next_state(ctx(\"кадастр арқылы\", state=state))\n        assert \"объект косу\" in new.original_question\n        assert \"кадастр арқылы\" in new.original_question\n\n    def test_situation_not_overwritten_once_set(self):\n        state = FlowState(intent=\"real_estate\", situation=\"через кадастровый номер\")\n        new = self.flow.next_state(ctx(\"адресный регистр\", state=state))\n        assert new.situation == \"через кадастровый номер\"  # must not switch","originalFile":"\"\"\"Tests for flow engine: LinearFlow, ScenarioFlow, FAQFlow, registry.\"\"\"\nimport pytest\n\nfrom app.flows.base import FlowContext\nfrom app.flows.faq import FAQFlow\nfrom app.flows.linear import LinearFlow\nfrom app.flows.registry import classify_intent, get_flow, has_flow_keywords\nfrom app.flows.scenario import ScenarioFlow\nfrom app.models.schemas import FlowState\n\n\ndef ctx(message, state=None, history=None, page=None, lang=\"ru\"):\n    return FlowContext(\n        message=message,\n        language=lang,\n        history=history or [],\n        page=page,\n        state=state or FlowState(),\n    )\n\n\n# ===========================================================================\n# LinearFlow — step progression\n# ===========================================================================\n\nclass TestLinearFlowStepProgression:\n    flow = LinearFlow()\n\n    def test_step_starts_at_1_when_entity_set(self):\n        state = FlowState(intent=\"tu_application\", entity=\"физическое лицо\", step=None)\n        new = self.flow.next_state(ctx(\"подать заявку\", state=state))\n        assert new.step == 1\n\n    def test_step_increments_on_progression_word(self):\n        for word in [\"дальше\", \"далее\", \"следующий\", \"да\", \"продолжай\", \"келесі\"]:\n            state = FlowState(intent=\"tu_application\", entity=\"физическое лицо\", step=2)\n            new = self.flow.next_state(ctx(word, state=state))\n            assert new.step == 3, f\"step should advance to 3 for '{word}'\"\n\n    def test_step_capped_at_max(self):\n        state = FlowState(intent=\"tu_application\", entity=\"физическое лицо\", step=5)\n        new = self.flow.next_state(ctx(\"дальше\", state=state))\n        assert new.step == 5\n\n    def test_step_not_started_without_entity(self):\n        state = FlowState(intent=\"tu_application\", entity=None, step=None)\n        new = self.flow.next_state(ctx(\"подать заявку\", state=state))\n        assert new.step is None\n\n    def test_non_progression_message_doesnt_advance(self):\n        state = FlowState(intent=\"tu_application\", entity=\"физическое лицо\", step=3)\n        new = self.flow.next_state(ctx(\"что такое мощность?\", state=state))\n        assert new.step == 3\n\n    def test_original_state_not_mutated(self):\n        state = FlowState(intent=\"tu_application\", entity=\"физическое лицо\", step=2)\n        original_step = state.step\n        self.flow.next_state(ctx(\"дальше\", state=state))\n        assert state.step == original_step  # model_copy() used — no mutation\n\n\nclass TestLinearFlowFinalStep:\n    flow = LinearFlow()\n\n    def test_final_step_all_progression_phrases(self):\n        for word in [\"дальше\", \"далее\", \"да\", \"следующий\", \"жалғастыр\"]:\n            state = FlowState(intent=\"tu_application\", entity=\"физическое лицо\", step=5)\n            new = self.flow.next_state(ctx(word, state=state))\n            assert new.step == 5, f\"should stay at 5 for '{word}'\"\n\n    def test_final_step_non_progression_unchanged(self):\n        state = FlowState(intent=\"tu_application\", entity=\"юридическое лицо\", step=5)\n        new = self.flow.next_state(ctx(\"как подписать?\", state=state))\n        assert new.step == 5\n\n\nclass TestLinearFlowQuery:\n    flow = LinearFlow()\n\n    def test_query_contains_step_and_entity(self):\n        state = FlowState(entity=\"физическое лицо\", step=3)\n        q = self.flow.build_query(ctx(\"что делать?\", state=state))\n        assert \"шаг 3\" in q\n        assert \"физическое лицо\" in q\n\n    def test_query_without_step_still_has_entity(self):\n        state = FlowState(entity=\"юридическое лицо\", step=None)\n        q = self.flow.build_query(ctx(\"подать заявку\", state=state))\n        assert \"юридическое лицо\" in q\n        assert \"шаг\" not in q\n\n    def test_query_empty_entity_step_returns_message(self):\n        state = FlowState(entity=None, step=None)\n        q = self.flow.build_query(ctx(\"вопрос\", state=state))\n        assert \"вопрос\" in q\n\n\n# ===========================================================================\n# ScenarioFlow — query building\n# ===========================================================================\n\nclass TestScenarioFlow:\n    flow = ScenarioFlow()\n\n    def test_query_includes_entity(self):\n        state = FlowState(entity=\"юридическое лицо\")\n        q = self.flow.build_query(ctx(\"добавить объект\", state=state))\n        assert \"юридическое лицо\" in q\n\n    def test_query_uses_original_question_as_anchor(self):\n        state = FlowState(entity=\"физическое лицо\",\n                          original_question=\"жылжымайтын мүлікті қалай қосуға болады?\")\n        q = self.flow.build_query(ctx(\"ЖТ\", state=state))\n        assert \"жылжымайтын мүлікті қалай қосуға болады?\" in q\n        assert \"физическое лицо\" in q\n\n    def test_query_falls_back_to_message_without_original_question(self):\n        state = FlowState(entity=\"физическое лицо\")\n        q = self.flow.build_query(ctx(\"добавить объект\", state=state))\n        assert \"добавить объект\" in q\n        assert \"физическое лицо\" in q\n\n    def test_no_history_uses_message_only(self):\n        state = FlowState(entity=\"физическое лицо\")\n        q = self.flow.build_query(ctx(\"добавить объект\", state=state, history=[]))\n        assert \"добавить объект\" in q\n\n    # --- next_state / situation detection ---\n\n    def test_cadastre_keyword_sets_situation_1(self):\n        state = FlowState(intent=\"real_estate\", original_question=\"объект косу\")\n        new = self.flow.next_state(ctx(\"кадастр арқылы\", state=state))\n        assert new.situation == 1\n\n    def test_address_keyword_sets_situation_2(self):\n        state = FlowState(intent=\"real_estate\", original_question=\"объект косу\")\n        new = self.flow.next_state(ctx(\"адресный регистр\", state=state))\n        assert new.situation == 2\n\n    def test_situation_answer_appended_to_original_question(self):\n        state = FlowState(intent=\"real_estate\", original_question=\"объект косу\")\n        new = self.flow.next_state(ctx(\"кадастр арқылы\", state=state))\n        assert \"объект косу\" in new.original_question\n        assert \"кадастр арқылы\" in new.original_question\n\n    def test_situation_not_overwritten_once_set(self):\n        state = FlowState(intent=\"real_estate\", situation=1)\n        new = self.flow.next_state(ctx(\"адресный регистр\", state=state))\n        assert new.situation == 1  # must not switch to 2\n\n    def test_unknown_answer_preserves_none_situation(self):\n        state = FlowState(intent=\"real_estate\")\n        new = self.flow.next_state(ctx(\"не знаю\", state=state))\n        assert new.situation is None\n\n    def test_question_about_cadastre_does_not_set_situation(self):\n        state = FlowState(intent=\"real_estate\")\n        new = self.flow.next_state(ctx(\"как получить кадастровый номер?\", state=state))\n        assert new.situation is None\n\n    def test_question_about_cadastre_kz_does_not_set_situation(self):\n        state = FlowState(intent=\"real_estate\")\n        new = self.flow.next_state(ctx(\"кадастрлық нөмірді қалай алуға болады?\", state=state))\n        assert new.situation is None\n\n\n# ===========================================================================\n# FAQFlow\n# ===========================================================================\n\nclass TestFAQFlow:\n    flow = FAQFlow()\n\n    def test_query_is_raw_message(self):\n        q = self.flow.build_query(ctx(\"как зарегистрироваться?\"))\n        assert q == \"как зарегистрироваться?\"\n\n    def test_does_not_require_entity(self):\n        assert self.flow.requires_entity is False\n\n\n# ===========================================================================\n# Registry — intent classification\n# ===========================================================================\n\nclass TestClassifyIntent:\n    def test_detect_tu_from_keyword(self):\n        assert classify_intent(\"технические условия\", None, None) == \"tu_application\"\n\n    def test_detect_tu_from_space_padded_keyword(self):\n        # \" ту \" requires spaces around\n        assert classify_intent(\"хочу ту подать\", None, None) == \"tu_application\"\n\n    def test_detect_re_from_keyword(self):\n        assert classify_intent(\"добавить объект недвижимости\", None, None) == \"real_estate\"\n\n    def test_no_keywords_returns_none(self):\n        assert classify_intent(\"как зарегистрироваться\", None, None) is None\n\n    def test_sticky_preserves_tu_intent(self):\n        result = classify_intent(\"физическое лицо\", None, \"tu_application\")\n        assert result == \"tu_application\"\n\n    def test_sticky_preserves_re_intent(self):\n        result = classify_intent(\"кадастровый номер\", None, \"real_estate\")\n        # \"кадастр\" is a real_estate keyword — not a switch, preserves intent\n        result2 = classify_intent(\"что-то вообще не связанное\", None, \"real_estate\")\n        assert result2 == \"real_estate\"\n\n    def test_explicit_switch_tu_to_re(self):\n        result = classify_intent(\"хочу добавить объект недвижимости\", None, \"tu_application\")\n        assert result == \"real_estate\"\n\n    def test_explicit_switch_re_to_tu(self):\n        result = classify_intent(\"мне нужны технические условия\", None, \"real_estate\")\n        assert result == \"tu_application\"\n\n    def test_page_based_tu_detection(self):\n        assert classify_intent(\"как заполнить?\", \"шаг 1\", None) == \"tu_application\"\n        assert classify_intent(\"как заполнить?\", \"шаг 3\", None) == \"tu_application\"\n\n    def test_page_based_re_detection(self):\n        assert classify_intent(\"помогите\", \"объект недвижимости\", None) == \"real_estate\"\n\n    def test_none_intent_no_page_no_keywords(self):\n        assert classify_intent(\"привет\", None, None) is None\n\n\nclass TestHasFlowKeywords:\n    def test_tu_keywords(self):\n        assert has_flow_keywords(\"технические условия\")\n        assert has_flow_keywords(\"техусловия\")\n\n    def test_re_keywords(self):\n        assert has_flow_keywords(\"объект недвижимости\")\n        assert has_flow_keywords(\"кадастровый номер\")\n        assert not has_flow_keywords(\"кадастр\")  # bare \"кадастр\" no longer triggers\n\n    def test_no_keywords(self):\n        assert not has_flow_keywords(\"как зарегистрироваться\")\n        assert not has_flow_keywords(\"не пришло письмо\")\n        assert not has_flow_keywords(\"забыл пароль\")\n        assert not has_flow_keywords(\"физическое лицо\")\n\n\nclass TestGetFlow:\n    def test_tu_returns_linear(self):\n        assert isinstance(get_flow(\"tu_application\"), LinearFlow)\n\n    def test_re_returns_scenario(self):\n        assert isinstance(get_flow(\"real_estate\"), ScenarioFlow)\n\n    def test_none_returns_faq(self):\n        assert isinstance(get_flow(None), FAQFlow)\n\n    def test_unknown_intent_returns_faq(self):\n        assert isinstance(get_flow(\"unknown_intent\"), FAQFlow)\n\n\n# ===========================================================================\n# Invalid transitions\n# ===========================================================================\n\nclass TestInvalidTransitions:\n    flow = LinearFlow()\n\n    def test_no_step_without_entity_even_after_progression(self):\n        \"\"\"Step should never start without an entity set.\"\"\"\n        state = FlowState(intent=\"tu_application\", entity=None, step=None)\n        for word in [\"дальше\", \"да\", \"следующий\"]:\n            new = self.flow.next_state(ctx(word, state=state))\n            assert new.step is None, f\"step must remain None for '{word}' without entity\"\n\n    def test_step_doesnt_regress(self):\n        \"\"\"Non-progression messages must not decrement step.\"\"\"\n        state = FlowState(intent=\"tu_application\", entity=\"физическое лицо\", step=4)\n        new = self.flow.next_state(ctx(\"объясни снова шаг 2\", state=state))\n        assert new.step == 4\n","structuredPatch":[{"oldStart":127,"oldLines":15,"newStart":127,"newLines":15,"lines":[" ","     # --- next_state / situation detection ---"," ","-    def test_cadastre_keyword_sets_situation_1(self):","+    def test_cadastre_keyword_sets_situation_cadastre(self):","         state = FlowState(intent=\"real_estate\", original_question=\"объект косу\")","         new = self.flow.next_state(ctx(\"кадастр арқылы\", state=state))","-        assert new.situation == 1","+        assert new.situation == \"через кадастровый номер\""," ","-    def test_address_keyword_sets_situation_2(self):","+    def test_address_keyword_sets_situation_address(self):","         state = FlowState(intent=\"real_estate\", original_question=\"объект косу\")","         new = self.flow.next_state(ctx(\"адресный регистр\", state=state))","-        assert new.situation == 2","+        assert new.situation == \"через адресный регистр\""," ","     def test_situation_answer_appended_to_original_question(self):","         state = FlowState(intent=\"real_estate\", original_question=\"объект косу\")"]},{"oldStart":144,"oldLines":9,"newStart":144,"newLines":9,"lines":["         assert \"кадастр арқылы\" in new.original_question"," ","     def test_situation_not_overwritten_once_set(self):","-        state = FlowState(intent=\"real_estate\", situation=1)","+        state = FlowState(intent=\"real_estate\", situation=\"через кадастровый номер\")","         new = self.flow.next_state(ctx(\"адресный регистр\", state=state))","-        assert new.situation == 1  # must not switch to 2","+        assert new.situation == \"через кадастровый номер\"  # must not switch"," ","     def test_unknown_answer_preserves_none_situation(self):","         state = FlowState(intent=\"real_estate\")"]}],"userModified":false,"replaceAll":false},"tool_use_id":"toolu_01K8Z4xMBBY1DRqwfDK1Uf3K","duration_ms":5}

2026-05-13T21:03:13.612Z {"session_id":"41f2eab1-8bcc-4841-8211-32ca523860b0","transcript_path":"C:\\Users\\yasmi\\.claude\\projects\\e--workstuff-platform-ai-assistant\\41f2eab1-8bcc-4841-8211-32ca523860b0.jsonl","cwd":"e:\\workstuff\\platform_ai_assistant","permission_mode":"acceptEdits","effort":{"level":"medium"},"hook_event_name":"PreToolUse","tool_name":"Edit","tool_input":{"file_path":"e:\\workstuff\\platform_ai_assistant\\app\\services\\llm_service.py","old_string":"def _build_system_prompt(\n    language: str,\n    history: str,\n    intent: Optional[str],\n    entity: Optional[str],\n    current_step: Optional[int],\n    page: Optional[str],\n) -> str:","new_string":"def _build_system_prompt(\n    language: str,\n    history: str,\n    intent: Optional[str],\n    entity: Optional[str],\n    current_step: Optional[int],\n    page: Optional[str],\n    situation: Optional[str] = None,\n) -> str:","replace_all":false},"tool_use_id":"toolu_01AnvKS3EdRgbubZvh4DwDaG"}

2026-05-13T21:03:14.230Z {"session_id":"41f2eab1-8bcc-4841-8211-32ca523860b0","transcript_path":"C:\\Users\\yasmi\\.claude\\projects\\e--workstuff-platform-ai-assistant\\41f2eab1-8bcc-4841-8211-32ca523860b0.jsonl","cwd":"e:\\workstuff\\platform_ai_assistant","permission_mode":"acceptEdits","effort":{"level":"medium"},"hook_event_name":"PostToolUse","tool_name":"Edit","tool_input":{"file_path":"e:\\workstuff\\platform_ai_assistant\\app\\services\\llm_service.py","old_string":"def _build_system_prompt(\n    language: str,\n    history: str,\n    intent: Optional[str],\n    entity: Optional[str],\n    current_step: Optional[int],\n    page: Optional[str],\n) -> str:","new_string":"def _build_system_prompt(\n    language: str,\n    history: str,\n    intent: Optional[str],\n    entity: Optional[str],\n    current_step: Optional[int],\n    page: Optional[str],\n    situation: Optional[str] = None,\n) -> str:","replace_all":false},"tool_response":{"filePath":"e:\\workstuff\\platform_ai_assistant\\app\\services\\llm_service.py","oldString":"def _build_system_prompt(\n    language: str,\n    history: str,\n    intent: Optional[str],\n    entity: Optional[str],\n    current_step: Optional[int],\n    page: Optional[str],\n) -> str:","newString":"def _build_system_prompt(\n    language: str,\n    history: str,\n    intent: Optional[str],\n    entity: Optional[str],\n    current_step: Optional[int],\n    page: Optional[str],\n    situation: Optional[str] = None,\n) -> str:","originalFile":"from __future__ import annotations\n\nimport httpx\nimport os\nfrom typing import Optional\nfrom dotenv import load_dotenv\n\nload_dotenv()\n\nLLM_PROVIDER = os.getenv(\"LLM_PROVIDER\", \"openai\")\nOLLAMA_BASE_URL = os.getenv(\"OLLAMA_BASE_URL\", \"http://localhost:11434\")\nOLLAMA_MODEL = os.getenv(\"OLLAMA_MODEL\", \"llama3.2\")\nOPENAI_API_KEY = os.getenv(\"OPENAI_API_KEY\", \"\")\nOPENAI_MODEL = os.getenv(\"OPENAI_MODEL\", \"gpt-4.1-nano\")\n\n_INTENT_LABELS = {\n    \"real_estate\": \"Добавление объекта недвижимости\",\n    \"tu_application\": \"Заявление на технические условия\",\n}\n\n# ---------------------------------------------------------------------------\n# Static prompt prefix — identical across requests so OpenAI can cache it.\n# Dynamic sections (history, intent_context, step_control) are appended after.\n# ---------------------------------------------------------------------------\n\n_STATIC_PROMPT_RU = \"\"\"<role>\nТы — официальный ИИ-ассистент платформы iSEL.\nЯзык: русский.\n</role>\n\n<language_rule>\nЯзык пользователя: РУССКИЙ. Отвечай на русском языке.\n</language_rule>\n\n<intent_handling>\nПОШАГОВЫЕ ИНТЕНТЫ (заявление на ТУ):\n- Показывай ОДИН шаг за раз.\n- Текущий шаг передаётся явно в <step_control>. Не определяй шаг самостоятельно.\n- После шага 5 — не предлагай шаг 6 и не спрашивай о продолжении.\n\nСИТУАЦИОННЫЕ ИНТЕНТЫ (объект недвижимости):\n- Не выдавай все ситуации сразу.\n- Если пользователь спрашивает «как добавить объект» — задай ОДИН уточняющий вопрос:\n  «Вы хотите добавить объект через адресный регистр или через кадастровый номер?»\n- Если пользователь отвечает «через кадастр» / «кадастр аркылы» / «по кадастру» —\n  это ВЫБОР СПОСОБА ДОБАВЛЕНИЯ, а не вопрос о кадастровом номере.\n  Дай инструкцию по добавлению объекта через кадастровый номер:\n  укажите номер в поле → «Отправить запрос» → проверка собственника → «Обновить».\n- Если пользователь отвечает «через адресный регистр» / «адрес аркылы» —\n  дай инструкцию по добавлению через адресный регистр.\n- Только если пользователь ЯВНО спрашивает «как получить кадастровый номер» /\n  «где найти» / «как узнать» — дай источники:\n  правоустанавливающие документы, кадастровая справка, госакты, eGov.\n- НИКОГДА не придумывай новые уточняющие вопросы сверх указанных выше.\n\nОПРЕДЕЛЕНИЕ ФЛ/ЮЛ:\n- Тип пользователя передаётся в <intent_context>.\n- НИКОГДА не спрашивай пользователя о его типе лица повторно.\n</intent_handling>\n\n<navigation_facts>\nПодача заявки на ТУ: Личный кабинет → левое меню **Услуги** → категория **Электроснабжение** → услуга «Выдача технических условий на присоединение к электрическим сетям»\nДобавление объекта недвижимости: Личный кабинет → главная страница → блок **Объекты недвижимости** → кнопка **Добавить**\nСтатус заявки и готовые документы: Личный кабинет → **Услуги** → вкладка **Обращения**\nСкачать ТУ или мотивированный отказ: найти строку в таблице **Обращения** → нажать иконку **Скачать** или кнопку **Просмотр**\n</navigation_facts>\n\n<rules>\n1. Контекст извлечён из графа знаний платформы iSEL (LightRAG hybrid retrieval).\n2. Используй историю диалога для понимания текущего шага или ситуации.\n3. Найди в контексте ОДИН блок, соответствующий текущему шагу или ситуации.\n4. Воспроизведи шаблон ДОСЛОВНО — не перефразируй, не сокращай.\n5. Никогда не смешивай шаблоны из разных ситуаций или шагов.\n6. Если подходящего шаблона нет — ответь точно: «Не могу найти точный ответ. Рекомендую обратиться к оператору: **+7 775 990 15 36**». Никогда не дополняй ответ из собственных знаний.\n7. Никогда не начинай ответ со слов «Шаблон ответа» или «Граф показывает».\n8. Не придумывай шаги, которых нет в документе - воспроизводи только те шаги, которые явно перечислены в извлечённых чанках.\n9. Если вопрос не связан с платформой iSEL — вежливо откажи.\n10. Если контекст содержит JSON-сущности (entity/description) — используй их поля description для составления ответа.\n11. Предпочитай блоки с нумерованными шагами или буллетами; если их нет — синтезируй инструкцию из описаний сущностей в контексте.\n12. Никогда не выдавай несколько шагов или ситуаций в одном ответе.\n13. Если пользователь спрашивает о статусе, документах или отказе — используй пути из <navigation_facts>.\n14. НИКОГДА не смешивай пути из <navigation_facts>. Подача заявки на ТУ идёт через **Услуги → Электроснабжение**, а НЕ через **Объекты недвижимости**. Статус заявки проверяется во вкладке **Обращения** внутри **Услуг**, а НЕ на главной странице. Каждый путь используй строго по назначению.\n15. Кадастровый номер объекта недвижимости получают из документов: кадастровая справка, кадастровая выписка, госакты на земельный участок, правоустанавливающие документы, портал eGov. НИКОГДА не направляй пользователя за кадастровым номером в услугу «Выдача технических условий» или любой другой раздел подачи ТУ — эти услуги не имеют отношения к кадастровому номеру.\n</rules>\n\n<formatting>\n- Шаги нумеруй: 1. 2. 3.\n- Каждый шаг с новой строки.\n- Кнопки платформы жирным: **Добавить**, **Далее**, **Отправить**, **Подписать**\n- Разделы платформы жирным: **Объекты недвижимости**, **Обращения**, **Данные заявления**\n- Важные термины жирным: **физическое лицо**, **юридическое лицо**, **кадастровый номер**, **ЭЦП**\n- Телефон жирным: **+7 775 990 15 36**\n- Между блоками пустая строка.\n- Предупреждения начинай с ⚠️\n- Ссылки указывай полностью.\n</formatting>\"\"\"\n\n_STATIC_PROMPT_KZ = \"\"\"<role>\nТы — официальный ИИ-ассистент платформы iSEL.\nЯзык: казахский.\n</role>\n\n<language_rule>\nЯзык пользователя: КАЗАХСКИЙ. Отвечай ИСКЛЮЧИТЕЛЬНО на казахском языке.\nЕсли <context> содержит русские инструкции — переведи их на казахский полностью перед ответом.\nКАТЕГОРИЧЕСКИ ЗАПРЕЩЕНО отвечать на русском языке.\n</language_rule>\n\n<intent_handling>\nПОШАГОВЫЕ ИНТЕНТЫ (заявление на ТУ):\n- Показывай ОДИН шаг за раз.\n- Текущий шаг передаётся явно в <step_control>. Не определяй шаг самостоятельно.\n- После шага 5 — не предлагай шаг 6 и не спрашивай о продолжении.\n\nСИТУАЦИОННЫЕ ИНТЕНТЫ (объект недвижимости):\n- Не выдавай все ситуации сразу.\n- Егер пайдаланушы «объектіні қалай қосуға болады» деп сұраса — БІР нақтылау сұрағын қой:\n  «Сіз объектіні адрестік регистр арқылы ма, әлде кадастрлық нөмір арқылы ма қосқыңыз келеді?»\n- Егер пайдаланушы «кадастр арқылы» / «через кадастр» / «по кадастру» деп жауап берсе —\n  бұл ҚОСУ ӘДІСІН ТАҢДАУ, кадастрлық нөмір туралы сұрақ ЕМЕС.\n  Кадастрлық нөмір арқылы объектіні қосу бойынша нұсқаулық бер:\n  нөмірді өріске енгізіңіз → «Отправить запрос» → меншік иесін тексеру → «Обновить».\n- Егер пайдаланушы «адрес арқылы» / «адрестік регистр арқылы» деп жауап берсе —\n  адрестік регистр арқылы қосу бойынша нұсқаулық бер.\n- Тек егер пайдаланушы АНЫҚ «кадастрлық нөмірді қалай алуға болады» /\n  «қайдан табуға болады» / «қалай білуге болады» деп сұраса — көздерін айт:\n  құқық белгілейтін құжаттар, кадастрлық анықтама, мемлекеттік актілер, eGov.\n- ЕШҚАШАН жоғарыда көрсетілгендерден тыс жаңа нақтылау сұрақтарын ойлап таппа.\n\nОПРЕДЕЛЕНИЕ ФЛ/ЮЛ (ЖТ/ЗТ):\n- Тип пользователя передаётся в <intent_context>.\n- НИКОГДА не спрашивай пользователя о его типе лица повторно.\n</intent_handling>\n\n<navigation_facts>\nТШ-ға өтініш беру: Жеке кабинет → сол жақ мәзір **Қызметтер** → **Электрмен жабдықтау** санаты → «Электр желілеріне қосылуға техникалық шарттар беру» қызметі\nЖылжымайтын мүлік объектісін қосу: Жеке кабинет → басты бет → **Жылжымайтын мүлік объектілері** блогы → **Қосу** батырмасы\nӨтініш мәртебесі мен дайын құжаттар: Жеке кабинет → **Қызметтер** → **Өтініштер** қосымша беті\nТШ немесе дәлелді бас тартуды жүктеу: **Өтініштер** кестесіндегі жолды тауып → **Жүктеу** немесе **Қарау** батырмасын басу\n</navigation_facts>\n\n<rules>\n1. Контекст извлечён из графа знаний платформы iSEL (LightRAG hybrid retrieval).\n2. Используй историю диалога для понимания текущего шага или ситуации.\n3. Найди в контексте ОДИН блок, соответствующий текущему шагу или ситуации.\n4. Воспроизведи шаблон ДОСЛОВНО — переводя на казахский при необходимости.\n5. Никогда не смешивай шаблоны из разных ситуаций или шагов.\n6. Если подходящего шаблона нет — ответь: «Дәл жауап таба алмадым. Операторға хабарласыңыз: **+7 775 990 15 36**».\n7. Никогда не начинай ответ со слов «Жауап үлгісі» или «Граф показывает».\n8. Не придумывай шаги, которых нет в документе - воспроизводи только те шаги, которые явно перечислены в извлечённых чанках.\n9. Если вопрос не связан с платформой iSEL — вежливо откажи на казахском.\n10. Егер контекст JSON-сущности (entity/description) болса — description өрістерін жауап жасауға пайдалан.\n11. Нөмірленген қадамдары бар блоктарды қолдан; олар жоқ болса — контекстегі сущность сипаттамаларынан нұсқаулық жаса.\n12. Никогда не выдавай несколько шагов или ситуаций в одном ответе.\n13. Егер пайдаланушы мәртебе, құжат немесе бас тарту туралы сұраса — <navigation_facts> жолдарын пайдалан.\n14. ЕШҚАШАН <navigation_facts> жолдарын араластырма. ТШ-ға өтініш беру **Қызметтер → Электрмен жабдықтау** арқылы жүреді, **Жылжымайтын мүлік объектілері** арқылы ЕМЕС. Өтініш мәртебесі **Қызметтер** ішіндегі **Өтініштер** бетінде тексеріледі, басты бетте ЕМЕС. Әр жолды тек өз мақсаты бойынша пайдалан.\n15. Жылжымайтын мүлік объектісінің кадастрлық нөмірі құжаттардан алынады: кадастрлық анықтама, кадастрлық үзінді, жер учаскесіне мемлекеттік акт, құқық белгілейтін құжаттар, eGov порталы. ЕШҚАШАН пайдаланушыны кадастрлық нөмір алу үшін «Техникалық шарттар беру» қызметіне немесе ТШ берумен байланысты кез келген бөлімге бағыттама — бұл қызметтердің кадастрлық нөмірге қатысы жоқ.\n</rules>\n\n<formatting>\n- Шаги нумеруй: 1. 2. 3.\n- Каждый шаг с новой строки.\n- Кнопки платформы жирным: **Қосу**, **Әрі қарай**, **Жіберу**, **Қол қою**\n- Важные термины жирным: **жеке тұлға**, **заңды тұлға**, **кадастрлық нөмір**, **ЭЦҚ**\n- Телефон жирным: **+7 775 990 15 36**\n- Между блоками пустая строка.\n- Предупреждения начинай с ⚠️\n</formatting>\"\"\"\n\n\ndef _build_system_prompt(\n    language: str,\n    history: str,\n    intent: Optional[str],\n    entity: Optional[str],\n    current_step: Optional[int],\n    page: Optional[str],\n) -> str:\n    static = _STATIC_PROMPT_KZ if language == \"kz\" else _STATIC_PROMPT_RU\n    dynamic_parts: list[str] = []\n\n    if history:\n        dynamic_parts.append(f\"<history>\\n{history}\\n</history>\")\n\n    if intent or entity or page:\n        intent_label = _INTENT_LABELS.get(intent or \"\", \"не определён\")\n        dynamic_parts.append(\n            f\"<intent_context>\\n\"\n            f\"Интент: {intent_label}\\n\"\n            f\"Тип пользователя: {entity or 'не определено'}\\n\"\n            f\"Страница: {page or 'не указана'}\\n\"\n            f\"</intent_context>\"\n        )\n\n    if current_step is not None:\n        next_step = current_step + 1\n        if current_step < 5:\n            if language == \"kz\":\n                step_note = (\n                    \"После инструкции добавь: «Барлық міндетті өрістерді толтырғаннан кейін \"\n                    \"келесі қадамға өту үшін **Әрі қарай** батырмасын басыңыз.»\"\n                )\n            else:\n                step_note = (\n                    \"После инструкции добавь: «После заполнения всех обязательных полей \"\n                    \"нажмите кнопку **Далее**, чтобы перейти к следующему шагу.»\"\n                )\n        else:\n            step_note = (\n                \"Это ПОСЛЕДНИЙ шаг. Дай инструкцию по подписи и отправке. НИКОГДА не предлагай шаг 6. \"\n                \"После инструкции добавь: «После отправки статус заявки и готовые ТУ появятся в \"\n                \"**Личный кабинет → Услуги → вкладка Обращения**.»\"\n            )\n        dynamic_parts.append(\n            f\"<step_control>\\n\"\n            f\"Текущий шаг: {current_step} из 5\\n\"\n            f\"Отвечай СТРОГО по шагу {current_step}. Не включай другие шаги.\\n\"\n            f\"{step_note}\\n\"\n            f\"</step_control>\"\n        )\n\n    if dynamic_parts:\n        return static + \"\\n\\n\" + \"\\n\\n\".join(dynamic_parts)\n    return static\n\n\n# ---------------------------------------------------------------------------\n# Public interface\n# ---------------------------------------------------------------------------\n\nasync def ask_llm(\n    question: str,\n    context: str,\n    page: Optional[str] = None,\n    language: str = \"ru\",\n    history: str = \"\",\n    intent: Optional[str] = None,\n    entity: Optional[str] = None,\n    current_step: Optional[int] = None,\n) -> str:\n    system = _build_system_prompt(\n        language=language,\n        history=history,\n        intent=intent,\n        entity=entity,\n        current_step=current_step,\n        page=page,\n    )\n    prompt = f\"<context>\\n{context}\\n</context>\\n\\n<question>\\n{question}\\n</question>\\n\\n<answer>\"\n\n    if LLM_PROVIDER == \"openai\":\n        return await _call_openai(system, prompt)\n    return await _call_ollama(system, prompt)\n\n\n# ---------------------------------------------------------------------------\n# Provider implementations\n# ---------------------------------------------------------------------------\n\nasync def _call_openai(system: str, prompt: str) -> str:\n    async with httpx.AsyncClient(timeout=30.0) as client:\n        try:\n            response = await client.post(\n                \"https://api.openai.com/v1/chat/completions\",\n                headers={\n                    \"Authorization\": f\"Bearer {OPENAI_API_KEY}\",\n                    \"Content-Type\": \"application/json\",\n                },\n                json={\n                    \"model\": OPENAI_MODEL,\n                    \"messages\": [\n                        {\"role\": \"system\", \"content\": system},\n                        {\"role\": \"user\", \"content\": prompt},\n                    ],\n                    \"temperature\": 0.0,\n                    \"max_tokens\": 1000,\n                },\n            )\n            data = response.json()\n            if response.status_code != 200:\n                error_msg = data.get(\"error\", {}).get(\"message\", \"Unknown error\")\n                return f\"Ошибка OpenAI: {error_msg}\"\n            return data[\"choices\"][0][\"message\"][\"content\"]\n        except Exception as e:\n            return f\"Ошибка LLM-сервиса: {str(e)}\"\n\n\nasync def _call_ollama(system: str, prompt: str) -> str:\n    async with httpx.AsyncClient(timeout=180.0) as client:\n        try:\n            response = await client.post(\n                f\"{OLLAMA_BASE_URL}/api/generate\",\n                json={\n                    \"model\": OLLAMA_MODEL,\n                    \"prompt\": prompt,\n                    \"system\": system,\n                    \"stream\": False,\n                    \"options\": {\"temperature\": 0.0},\n                },\n            )\n            data = response.json()\n            return data.get(\"response\", \"Ошибка генерации.\")\n        except Exception as e:\n            return f\"Ошибка LLM-сервиса: {str(e)}\"\n","structuredPatch":[{"oldStart":175,"oldLines":6,"newStart":175,"newLines":7,"lines":["     entity: Optional[str],","     current_step: Optional[int],","     page: Optional[str],","+    situation: Optional[str] = None,"," ) -> str:","     static = _STATIC_PROMPT_KZ if language == \"kz\" else _STATIC_PROMPT_RU","     dynamic_parts: list[str] = []"]}],"userModified":false,"replaceAll":false},"tool_use_id":"toolu_01AnvKS3EdRgbubZvh4DwDaG","duration_ms":6}

