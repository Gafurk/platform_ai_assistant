tuation header\n    p = new_doc.add_paragraph()\n    run = p.add_run(f\"Ситуация {idx}\")\n    run.bold = True\n\n    # Add the question\n    new_doc.add_paragraph(f\"Вопрос: {q_text}\")\n\n    # Add page context for quality filter\n    new_doc.add_paragraph(f\"Страница - Общие вопросы на платформе\")\n\n    # Add answer\n    new_doc.add_paragraph(f\"Ответ: {answer}\")\n    new_doc.add_paragraph()  # separator","originalFile":"#!/usr/bin/env python3\nimport sys\nsys.stdout.reconfigure(encoding='utf-8') if hasattr(sys.stdout, 'reconfigure') else None\nfrom docx import Document\n\n# Read original\ndoc = Document('data/docs/Интент Общие вопросы на платформе.docx')\n\n# Collect all paragraphs\nall_text = []\nfor para in doc.paragraphs:\n    text = para.text.strip()\n    if text:\n        all_text.append(text)\n\n# Extract metadata sections\nmetadata = []\nquestions = []\ni = 0\nwhile i < len(all_text):\n    text = all_text[i]\n\n    # Check if it's a metadata section\n    if any(kw in text for kw in [\"Цель интента\", \"Описание интента\", \"Требования\"]):\n        if i + 1 < len(all_text):\n            metadata.append((text, all_text[i + 1]))\n            i += 2\n            continue\n\n    # Check if it's a question (starts with digit and .)\n    if text and text[0].isdigit() and '. ' in text[:10] and \"Интент:\" not in text:\n        question = text\n        # Collect answer (next paragraphs until next question)\n        answer_lines = []\n        i += 1\n        while i < len(all_text):\n            next_text = all_text[i]\n            if next_text and next_text[0].isdigit() and '. ' in next_text[:10]:\n                break\n            answer_lines.append(next_text)\n            i += 1\n        answer = '\\n'.join(answer_lines).strip()\n        questions.append((question, answer))\n    else:\n        i += 1\n\nprint(f\"📊 Extracted: {len(metadata)} metadata sections, {len(questions)} Q&A pairs\\n\")\n\n# Create new document\nnew_doc = Document()\n\n# Add header\np = new_doc.add_paragraph()\nrun = p.add_run(\"Название интента: Общие вопросы на платформе\")\nrun.bold = True\n\np = new_doc.add_paragraph()\nrun = p.add_run(\"Цель интента\")\nrun.bold = True\nif metadata:\n    p = new_doc.add_paragraph(metadata[0][1])\n\n# Add questions as situations\nfor idx, (question, answer) in enumerate(questions, 1):\n    if idx > 25:\n        break\n\n    # Remove numbering from question\n    q_text = question\n    if q_text and q_text[0].isdigit() and '. ' in q_text[:10]:\n        q_text = q_text.split('. ', 1)[1]\n\n    # Add situation header\n    p = new_doc.add_paragraph()\n    run = p.add_run(f\"\\nСитуация {idx}\\n{q_text}\")\n    run.bold = True\n\n    # Add answer with bullet format for quality criteria\n    answer_lines = answer.split('\\n')\n    for line in answer_lines[:5]:  # First 5 lines\n        if line.strip():\n            p = new_doc.add_paragraph(line.strip(), style='List Bullet')\n    if len(answer_lines) > 5:\n        p = new_doc.add_paragraph('\\n'.join(answer_lines[5:]))\n\n# Save\nnew_doc.save('data/docs/Интент Общие вопросы на платформе.docx')\nprint(f\"✅ Document restructured: {len(questions[:25])} situations added\")\nprint(f\"💾 Saved to: data/docs/Интент Общие вопросы на платформе.docx\")\n","structuredPatch":[{"oldStart":72,"oldLines":17,"newStart":72,"newLines":19,"lines":[" ","     # Add situation header","     p = new_doc.add_paragraph()","-    run = p.add_run(f\"\\nСитуация {idx}\\n{q_text}\")","+    run = p.add_run(f\"Ситуация {idx}\")","     run.bold = True"," ","-    # Add answer with bullet format for quality criteria","-    answer_lines = answer.split('\\n')","-    for line in answer_lines[:5]:  # First 5 lines","-        if line.strip():","-            p = new_doc.add_paragraph(line.strip(), style='List Bullet')","-    if len(answer_lines) > 5:","-        p = new_doc.add_paragraph('\\n'.join(answer_lines[5:]))","+    # Add the question","+    new_doc.add_paragraph(f\"Вопрос: {q_text}\")"," ","+    # Add page context for quality filter","+    new_doc.add_paragraph(f\"Страница - Общие вопросы на платформе\")","+","+    # Add answer","+    new_doc.add_paragraph(f\"Ответ: {answer}\")","+    new_doc.add_paragraph()  # separator","+"," # Save"," new_doc.save('data/docs/Интент Общие вопросы на платформе.docx')"," print(f\"✅ Document restructured: {len(questions[:25])} situations added\")"]}],"userModified":false,"replaceAll":false},"tool_use_id":"toolu_01Xw1a9T7xmGD1pafq2QXRc4","duration_ms":5}

