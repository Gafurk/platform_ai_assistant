                    \"иә\",","+    \"жок\":                      \"жоқ\","," }"," "," "]}],"originalFile":"\"\"\"Normalize transliterated Kazakh (written with Russian letters) to proper Kazakh Cyrillic.\n\nOnly runs when the message has no Kazakh-specific characters (әғқңөұүі).\nLonger phrases are matched before shorter ones to prevent partial replacements.\n\"\"\"\n\n_KZ_CHARS = frozenset(\"әғқңөұүіӘҒҚҢӨҰҮІ\")\n\n# Keys MUST NOT contain Kazakh-specific chars — the function early-returns when\n# any such char is present, making those entries unreachable.\n_TRANSLIT_MAP: dict[str, str] = {\n    # --- Multi-word phrases first (prevent partial sub-word matches) ---\n    \"тех условия\":          \"техникалық шарттар\",\n    \"тех условие\":          \"техникалық шарттар\",\n    \"тех шарттар\":          \"техникалық шарттар\",\n    \"жилжимайтын мулик\":   \"жылжымайтын мүлік\",\n    \"профильге косу\":       \"профильге қосу\",\n    \"объект косу\":          \"объект қосу\",\n    \"ту алу\":               \"ТҚ алу\",\n    \"ту беру\":              \"ТҚ беру\",\n    # --- Single words ---\n    \"жилжимайтын\":         \"жылжымайтын\",\n    \"мулик\":               \"мүлік\",\n    \"калайсыз\":            \"қалайсыз\",\n    \"калайсын\":            \"қалайсын\",\n    \"калай\":               \"қалай\",\n    \"отиниш\":              \"өтініш\",\n    \"салеметсиз\":          \"сәлеметсіз\",\n    \"салем\":               \"сәлем\",\n    \"комек\":               \"көмек\",\n    \"сурау\":               \"сұрау\",\n    \"кайда\":               \"қайда\",\n    \"кандай\":              \"қандай\",\n    \"кашан\":               \"қашан\",\n    \"косу\":                \"қосу\",\n    \"кажет\":               \"қажет\",\n    \"мумкин\":              \"мүмкін\",\n    \"тусинбедим\":          \"түсінбедім\",\n    \"тусинди\":             \"түсінді\",\n    \"айтыныз\":             \"айтыңыз\",\n    \"корсетиниз\":          \"көрсетіңіз\",\n    \"жазыныз\":             \"жазыңыз\",\n