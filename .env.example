# ── Required ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Optional (defaults shown) ─────────────────────────────────────────────
# LLM provider: "openai" or "ollama"
LLM_PROVIDER=openai

# Chat responses — reasoning models supported (e.g. gpt-5-mini)
OPENAI_MODEL=gpt-4.1-nano

# Entity/relation extraction during ingestion — MUST be a non-reasoning model
LIGHTRAG_EXTRACT_MODEL=gpt-4.1-nano

# Ollama fallback (only used when LLM_PROVIDER=ollama)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2
